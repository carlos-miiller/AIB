<!--
    ============================================================================
     CORES — TEMA CLARO
    ============================================================================
     Derivado do escuro (Cores.Escuro.xaml), que é o que as specs descrevem.
     O que muda: as camadas BRANCAS translúcidas sobre o vidro escuro viram
     PRETAS translúcidas sobre o vidro claro; textos escurecem; lilás, verde
     e vermelho usados como TEXTO ficam mais escuros para ter contraste.
     O que NÃO muda: os degradês (NeonBrush é a marca; a bolha do usuário
     continua PrimaryBrush com texto branco) e o vermelho de ação destrutiva.
     Sombras mais leves: sobre fundo claro a de 55% parecia sujeira.

     Um arquivo por tema, com as MESMAS chaves (Cores.Escuro.xaml é o par). O
     App carrega um deles antes do Controls.xaml (ver Ui/Tema.cs). Chave
     nova entra nos dois arquivos: TemasTests cobra isso.

     Raios, fontes e medidas não mudam com o tema: moram em Tokens.xaml.
    ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════
         SUPERFÍCIES
         ══════════════════════════════════════════════════════════════════ -->

    <!-- O "vidro fumê". NÃO é blur: é cor sólida a 90%. Blur nativo
         (Gaussian/Acrylic/DWM) dá glitch de render no Windows e custa frame.
         Chat A1 / Configurações A1. -->
    <SolidColorBrush x:Key="GlassBrush"            Color="#F2F6F5FA"/>

    <SolidColorBrush x:Key="SurfaceCardBrush"      Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCodeBrush"      Color="#0F1B1830"/>
    <SolidColorBrush x:Key="SurfaceCodeBlockBrush" Color="#0B1B1830"/>
    <SolidColorBrush x:Key="SurfaceHoverSoftBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="SurfaceInputBarBrush"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceTooltipBrush"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceControlBrush"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceControlRoBrush" Color="#0A000000"/>

    <!-- ══════════════════════════════════════════════════════════════════
         BORDAS
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BorderCardBrush"        Color="#17000000"/>
    <SolidColorBrush x:Key="DividerBrush"           Color="#12000000"/>
    <SolidColorBrush x:Key="DividerTooltipBrush"    Color="#1A000000"/>
    <SolidColorBrush x:Key="DividerFieldBrush"      Color="#0F000000"/>
    <SolidColorBrush x:Key="BorderControlBrush"     Color="#24000000"/>
    <SolidColorBrush x:Key="BorderOutlineBtnBrush"  Color="#38000000"/>
    <SolidColorBrush x:Key="BorderOutlineHovBrush"  Color="#59000000"/>

    <!-- Lilás = ação em curso, item clicável, foco. -->
    <SolidColorBrush x:Key="AccentBorderBrush"       Color="#599B51E0"/>
    <SolidColorBrush x:Key="AccentBorderStrongBrush" Color="#809B51E0"/>
    <SolidColorBrush x:Key="AccentFocusBrush"        Color="#999B51E0"/>

    <SolidColorBrush x:Key="DangerBorderBrush"      Color="#66E5484D"/>
    <SolidColorBrush x:Key="DangerBorderHovBrush"   Color="#99E5484D"/>
    <SolidColorBrush x:Key="WarnBorderBrush"        Color="#66E28743"/>

    <!-- ══════════════════════════════════════════════════════════════════
         TEXTO
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="TextStrongBrush"       Color="#FF17151D"/>
    <SolidColorBrush x:Key="TextNormalBrush"       Color="#FF24212C"/>
    <SolidColorBrush x:Key="TextBodyBrush"         Color="#FF36323F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#FF625D6E"/>
    <SolidColorBrush x:Key="TextMutedBrush"        Color="#FF7C7788"/>

    <SolidColorBrush x:Key="AccentLilacBrush"      Color="#FF7A3DC2"/>
    <SolidColorBrush x:Key="SuccessBrush"          Color="#FF15803D"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="#FFE5484D"/>
    <SolidColorBrush x:Key="DangerTextBrush"       Color="#FFC02A2F"/>
    <SolidColorBrush x:Key="DangerHoverBrush"      Color="#FFF05257"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#FFC2601A"/>
    <SolidColorBrush x:Key="MagentaBrush"          Color="#FFC0307A"/>

    <!-- Link e destaque azul (o azul do degradê, um tom abaixo para contraste). Ouro:
         estrelas e a faixa de nível avançado — o ouro do escuro some sobre o branco. -->
    <SolidColorBrush x:Key="AccentBlueBrush"       Color="#FF2468A8"/>
    <SolidColorBrush x:Key="GoldBrush"             Color="#FFB7791F"/>

    <!-- ══════════════════════════════════════════════════════════════════
         PREENCHIMENTOS DE ESTADO
         Fundos translúcidos que aparecem repetidos nas duas specs.
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="AccentFill08Brush"  Color="#149B51E0"/>  <!-- hover de item de arquivo -->
    <SolidColorBrush x:Key="AccentFill10Brush"  Color="#1A9B51E0"/>  <!-- hover de botão outline -->
    <SolidColorBrush x:Key="AccentFill12Brush"  Color="#1F9B51E0"/>  <!-- aba ativa, caixa de ícone -->
    <SolidColorBrush x:Key="AccentFill14Brush"  Color="#269B51E0"/>  <!-- pill de nível -->
    <SolidColorBrush x:Key="AccentRing25Brush"  Color="#4D9B51E0"/>  <!-- anel do spinner -->
    <SolidColorBrush x:Key="AccentEdge24Brush"  Color="#4D9B51E0"/>  <!-- borda da caixa de ícone -->
    <SolidColorBrush x:Key="AccentFill07Brush"  Color="#129B51E0"/>  <!-- cartão de e-mail em contexto (§3.11) -->
    <SolidColorBrush x:Key="AccentEdge28Brush"  Color="#599B51E0"/>  <!-- círculo do estado vazio -->

    <SolidColorBrush x:Key="DangerFill12Brush"  Color="#1AE5484D"/>  <!-- marcador destrutivo do log -->
    <SolidColorBrush x:Key="DangerFill14Brush"  Color="#1FE5484D"/>  <!-- pill "Ação destrutiva" -->
    <SolidColorBrush x:Key="DangerFill16Brush"  Color="#26E5484D"/>  <!-- hover do botão fechar -->
    <SolidColorBrush x:Key="SuccessFill10Brush" Color="#2615803D"/>  <!-- linha que entra no antes e depois -->
    <SolidColorBrush x:Key="DangerEdge32Brush"  Color="#59E5484D"/>  <!-- borda da pill destrutiva -->

    <SolidColorBrush x:Key="WarnFill10Brush"    Color="#1FE28743"/>  <!-- faixa de contexto cheio -->
    <SolidColorBrush x:Key="ReadFill05Brush"    Color="#0A000000"/>  <!-- marcador de leitura no log -->

    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#29000000"/>
    <SolidColorBrush x:Key="ScrollThumbTrackBrush" Color="#40000000"/>

    <!-- Trilho do switch desligado. -->
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="SwitchKnobOffBrush"  Color="#FF7C7788"/>
    <SolidColorBrush x:Key="SwitchKnobOnBrush"   Color="#FFFFFFFF"/>

    <!-- ══════════════════════════════════════════════════════════════════
         GRADIENTES
         A moldura neon é a ÚNICA cor saturada da janela. Chat O2 /
         Configurações O3.
         ══════════════════════════════════════════════════════════════════ -->

    <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="0.35"/>
        <GradientStop Color="#D53F8C" Offset="0.65"/>
        <GradientStop Color="#E28743" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- Bolha do usuário, botão Salvar, botão enviar, switch ligado. -->
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- Moldura da barra de input do chat: três paradas, não quatro. -->
    <LinearGradientBrush x:Key="InputFrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="0.55"/>
        <GradientStop Color="#D53F8C" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════════════════════════════
         SOMBRAS
         A moldura externa PRECISA da sombra: sem ela a janela não lê como
         flutuante sobre o desktop. Chat O3 / Configurações O4.
         A bolha do USUÁRIO não tem sombra nem glow — Chat O5.
         ══════════════════════════════════════════════════════════════════ -->

    <DropShadowEffect x:Key="WindowShadow"  BlurRadius="60" ShadowDepth="15"
                      Direction="270" Opacity="0.28" Color="Black"/>
    <DropShadowEffect x:Key="CardShadow"    BlurRadius="8"  ShadowDepth="2"
                      Direction="270" Opacity="0.10" Color="Black"/>
    <DropShadowEffect x:Key="TooltipShadow" BlurRadius="18" ShadowDepth="6"
                      Direction="270" Opacity="0.22" Color="Black"/>
    <DropShadowEffect x:Key="SendGlow"      BlurRadius="16" ShadowDepth="4"
                      Direction="270" Opacity="0.30" Color="#9B51E0"/>

    <!-- Shadow Assistant §2. O orbe flutua sobre o desktop, sem janela por tras
         para o separar do papel de parede, entao a sombra dele e mais fechada e
         mais escura que a das janelas. -->
    <DropShadowEffect x:Key="OrbShadow"      BlurRadius="28" ShadowDepth="8"
                      Direction="270" Opacity="0.55" Color="Black"/>
    <DropShadowEffect x:Key="BarShadow"      BlurRadius="44" ShadowDepth="16"
                      Direction="270" Opacity="0.58" Color="Black"/>
</ResourceDictionary>
