<!--
    ============================================================================
     ESTILOS COMPARTILHADOS — derivados de Tokens.xaml
    ============================================================================
     Um estilo só entra aqui quando é usado por mais de uma tela, ou quando a
     spec o descreve como componente próprio (§3.6, §3.7, §3.8 de
     tela-configuracoes; §3.3 e §8.0 de tela-chat-v3).

     Nada de cor literal: tudo por StaticResource. Se um valor não existir em
     Tokens.xaml, ele deve ser acrescentado lá, não escrito aqui.
    ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Tokens mesclados AQUI, e não só no App.xaml. Um StaticResource dentro
         de um dicionário mesclado enxergar outro dicionário IRMÃO depende da
         ordem de carga e falha no designer. Mesclar o que se usa torna este
         arquivo autossuficiente. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════════════════════════════════════════════════════════════
         BARRA DE ROLAGEM DE 6px
         Sem setas, sem trilho visível. Usada na lista de mensagens, na área
         de seções das configurações e nas panes do painel lateral.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Estilo IMPLÍCITO, sem x:Key: toda barra do app segue a spec, e nenhuma
         tela precisa lembrar de aplicá-lo. A variante horizontal de 4px é a da
         trilha de ícones (§4.4) — a mesma barra, mais fina, e é ela que avisa
         que há mais ações fora de vista.
         Sem setas e sem trilho visível: a spec não tem nenhum dos dois. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <!-- MinWidth e MinHeight PRECISAM estar aqui.
             Um estilo implícito não substitui o estilo de tema inteiro: as propriedades que
             ele não define continuam vindo de lá. O tema do WPF traz MinWidth/MinHeight de
             SystemParameters.*ScrollBarHeight, que no Windows vale 17. Resultado medido:
             Width=6 no estilo e ActualWidth=17 na tela — a barra ficava com quase três vezes
             a espessura da spec, sem erro nenhum e sem nada no XAML que denunciasse. -->
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource ScrollThumbBrush}"
                                                    CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <!-- Os RepeatButton existem porque o Track os exige; não
                                 desenham nada. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource ScrollThumbTrackBrush}"
                                                            CornerRadius="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTÃO DE ÍCONE  34x34, r8
         Chat §3.3 / Configurações §3.3.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- §3.5 do chat — BOLHA DO USUÁRIO. Raio 18 uniforme, degradê primary, sem
         sombra e sem glow (O5). Morava no ChatWindow.xaml e passou para cá quando a
         pilha de falas do orbe precisou dela: a fala do usuário é a mesma coisa nos
         dois lugares, e duas cópias divergiriam. -->
    <Style x:Key="UserBubble" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBubble}"/>
        <Setter Property="Padding" Value="17,13"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Botao primario circular. Morava no ChatWindow.xaml e passou para ca quando a
         barra do Shadow Assistant precisou dele: a spec do orbe diz, em §4.7 (d), que o
         botao e "igual ao da janela de chat". Duas copias acabariam divergindo, e o
         usuario veria dois botoes de enviar levemente diferentes na mesma sessao. -->
<Style x:Key="SendButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource RecordButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource RecordButtonSize}"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="19" Effect="{StaticResource SendGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width"  Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusIconBtn}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fechar: mesma casca, hover vermelho. -->
    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="{StaticResource RadiusIconBtn}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerFill16Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         CONTROLE BASE — TextBox  (Configurações §3.6)
         Hover e foco usam a MESMA cor de borda: accentFocus.
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ControlTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControl}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentLilacBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentLilacBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                        </Trigger>
                        <!-- Somente leitura não reage a nada: o cursor de seta e a
                             borda parada são o que comunicam que não se edita.
                             Configurações §3.6 variante .readonly. -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceControlRoBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Valores técnicos conferidos caractere por caractere: Base URL, API Key,
         Modelo e Máximo de Tokens. Configurações A10. -->
    <Style x:Key="ControlTextBoxMono" TargetType="TextBox" BasedOn="{StaticResource ControlTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControlMono}"/>
    </Style>

    <!-- Caixa de VARIAS linhas: uma pasta por linha, um item por linha.
         Nao herda de ControlTextBox de proposito — aquele template tem altura fixa e
         barras de rolagem escondidas, e uma lista que cresce ficaria invisivel a partir
         da terceira linha. Aqui a rolagem aparece quando precisa. -->
    <Style x:Key="ControlTextBoxLista" TargetType="TextBox">
        <Setter Property="MinHeight" Value="84"/>
        <Setter Property="MaxHeight" Value="150"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControlMono}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentFocusBrush}"/>
    </Style>

    <Style x:Key="ControlPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControlMono}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentLilacBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         COMBOBOX  (Configurações §3.6)
         A seta nativa não segue a paleta e o popup default abre branco —
         os dois precisam de template próprio. Configurações A9.
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ControlComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControl}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="{StaticResource SurfaceControlBrush}"
                                            BorderBrush="{StaticResource BorderControlBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusControl}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selecionado" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,32,0"/>

                        <!-- A caixa de digitação da ComboBox EDITÁVEL.
                             O WPF procura este nome exato; sem ele, IsEditable="True" fica sem
                             onde desenhar nem onde receber texto — o campo aparece vazio e não
                             aceita digitação, e o que o usuário vê é o que o sistema desenhar
                             por conta própria, na cor dele, escura sobre este fundo.
                             As cores vêm do TemplatedParent para não haver uma segunda paleta
                             aqui dentro: a do texto, a do cursor e a da seleção. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 SelectionBrush="{StaticResource AccentLilacBrush}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Stretch"
                                 Margin="12,0,32,0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <!-- Chevron desenhado: 10px, stroke 1.6, viewBox 0 0 12 12. -->
                        <Path Data="M2.6,4.4 L6,7.8 L9.4,4.4"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="None"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceInputBarBrush}"
                                    BorderBrush="{StaticResource BorderControlBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Effect="{StaticResource TooltipShadow}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                        </Trigger>

                        <!-- Editável mostra a caixa de digitação; fixa mostra o item escolhido.
                             Os dois nunca ao mesmo tempo: sobrepostos, o texto sairia dobrado. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Selecionado" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ControlComboBoxMono" TargetType="ComboBox" BasedOn="{StaticResource ControlComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControlMono}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTÕES
         ══════════════════════════════════════════════════════════════════ -->

    <!-- "Alterar" (§3.7). Nunca preenchido: não pode competir com "Salvar". -->
    <Style x:Key="InlineButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderOutlineBtnBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControlMono}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentFocusBrush}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentFill10Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ §3.11  AS DUAS AÇÕES DO CABEÇALHO DE LEITURA ════════════════════
         "Abrir no Gmail" e "Recarregar". Menores e mais apagados que os botões
         de formulário: eles dividem a linha com o CAMINHO, e um par de botões
         de 36px ali roubaria a leitura do assunto, que é o que diz onde se
         está. -->
    <Style x:Key="AcaoDeCabecalho" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Casca" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Casca" Property="Background"
                                    Value="{StaticResource ReadFill05Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
                        </Trigger>
                        <!-- Desabilitado NÃO some (§3.11): enquanto o recarregar roda, um botão
                             que desaparece encolhe a linha e o caminho salta de largura. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ §3.11  O "CAIXA DE ENTRADA" DO CAMINHO ═══════════════════════════
         Sem borda e sem fundo: é um caminho, não uma ação. Só a cor muda no
         hover, que é o que diz que ele leva a algum lugar. -->
    <Style x:Key="CaminhoDeVolta" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentLilacBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Cancelar" / "Recusar": outline neutro. -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource InlineButton}">
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeField}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{StaticResource BorderOutlineBtnBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderOutlineHovBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Salvar": gradiente primary, SEM sombra nem glow. Desabilitado a 45%.
         Nasce desabilitado e só habilita com IsDirty. Configurações O7 / A8. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="24,9"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeField}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Reset de Fábrica": outline vermelho. Ação destrutiva — exige
         confirmação antes de executar. Configurações O8. -->
    <Style x:Key="DangerOutlineButton" TargetType="Button">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerFill12Brush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DangerBorderHovBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Permitir" do card de confirmação: cheio vermelho, sem glow. Chat §5.3. -->
    <Style x:Key="DangerFilledButton" TargetType="Button">
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeControl}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         SWITCH  (Configurações §3.8)
         Substitui as CheckBoxes da tela antiga. Trilho 38x22, botão 16x16.
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="ToolTip" Value="Desativado"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="38" Height="22"
                            Background="{StaticResource SwitchTrackOffBrush}"
                            CornerRadius="{StaticResource RadiusSwitch}">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{StaticResource SwitchKnobOffBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource SwitchKnobOnBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="16" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Style.Triggers vem DEPOIS de todos os Setters: elemento de
             propriedade no meio do conteúdo é erro de compilação (MC3088). -->
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="Ativado"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TIPOGRAFIA REUTILIZADA
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Cabeçalho de seção. Os TRÊS usam o MESMO cinza: pintar um de azul,
         outro de magenta e outro de laranja foi o erro que tirou a hierarquia
         da tela antiga. Configurações O5 / A2. -->
    <Style x:Key="SectionHeadText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- letter-spacing 0.10em ≈ CharacterSpacing 100 (unidade 1/1000 em). -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeField}"/>
        <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Linha de ajuda: SEMPRE visível. Nunca voltar a usar placeholder para
         informação necessária — ele some ao digitar. Configurações A6. -->
    <Style x:Key="FieldHelpText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHelp}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15.4"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Pill de nível (chat) e pill "Ação destrutiva" (§5.3) compartilham a
         geometria; só a cor muda. -->
    <Style x:Key="PillBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource AccentFill14Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePill}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentLilacBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TOOLTIP — §4.6
         A casca de TODOS os tooltips do app (D8): antes valia a nativa do
         Windows, fundo claro, canto reto e sem sombra, com as cores do
         design system aplicadas só no conteúdo. Fundo surfaceTooltip, borda
         accentBorder, r8, tooltipShadow, 11px textBody, padding 6,10.
         A variante EM BLOCO zera o Padding: as seções trazem o próprio.
         HasDropShadow fica True porque é ele que deixa o popup transparente;
         a sombra desenhada é a do Border, não a do sistema.
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Background" Value="{StaticResource SurfaceTooltipBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- A margem existe para a sombra caber, como no menu de contexto. -->
                    <Border Margin="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusTooltip}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource TooltipShadow}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         MENU DE CONTEXTO
         Não consta das specs: nasceu com o botão direito no histórico de
         conversas. Segue a casca do tooltip (§4.6), que é o elemento
         flutuante que já existia, para não inventar uma terceira aparência.
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- A margem existe para a sombra caber: o popup recorta no
                         limite do conteúdo, e sem folga a sombra sai cortada. -->
                    <Border Margin="8"
                            Background="{StaticResource SurfaceTooltipBrush}"
                            BorderBrush="{StaticResource BorderCardBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusTooltip}"
                            Padding="4"
                            Effect="{StaticResource TooltipShadow}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="6" Padding="10,6">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
                        </Trigger>
                        <!-- Tag="perigo": item que apaga. Vermelho só no hover, para a lista
                             em repouso não parecer um alerta. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="perigo"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerFill16Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4"
                            Background="{StaticResource BorderCardBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
