<!--
    ============================================================================
     DESIGN TOKENS — §1 de refactor-interface/tela-chat-v3.html
                     §1 de refactor-interface/tela-configuracoes.html
    ============================================================================
     Fonte de verdade: os dois HTML acima. Os valores aqui são a conversão
     mecânica de CSS para WPF; não inventar nem arredondar por conta própria.

     Conversão de rgba(r,g,b,a) para o hexadecimal do WPF: #AARRGGBB, com
     AA = round(a * 255). As specs já trazem o alfa em decimal nas tabelas de
     §1 — quando houver divergência de 1 unidade por arredondamento, vale o
     número escrito na spec.

     Este dicionário é compartilhado por TODAS as telas. Nenhuma cor literal
     deve voltar a aparecer nos arquivos de View: antes deste arquivo, #9B51E0
     estava escrito 27 vezes em 6 XAMLs.
    ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════════════
         SUPERFÍCIES
         ══════════════════════════════════════════════════════════════════ -->

    <!-- O "vidro fumê". NÃO é blur: é cor sólida a 90%. Blur nativo
         (Gaussian/Acrylic/DWM) dá glitch de render no Windows e custa frame.
         Chat A1 / Configurações A1. -->
    <SolidColorBrush x:Key="GlassBrush"            Color="#E6121216"/>

    <SolidColorBrush x:Key="SurfaceCardBrush"      Color="#09FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCodeBrush"      Color="#4D000000"/>
    <SolidColorBrush x:Key="SurfaceCodeBlockBrush" Color="#57000000"/>
    <SolidColorBrush x:Key="SurfaceHoverSoftBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceInputBarBrush"  Color="#FF16151C"/>
    <SolidColorBrush x:Key="SurfaceTooltipBrush"   Color="#FF1D1C24"/>
    <SolidColorBrush x:Key="SurfaceControlBrush"   Color="#47000000"/>
    <SolidColorBrush x:Key="SurfaceControlRoBrush" Color="#2E000000"/>

    <!-- ══════════════════════════════════════════════════════════════════
         BORDAS
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BorderCardBrush"        Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BorderCardHoverBrush"   Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush"           Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="DividerTooltipBrush"    Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DividerFieldBrush"      Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="BorderControlBrush"     Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderOutlineBtnBrush"  Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="BorderOutlineHovBrush"  Color="#4DFFFFFF"/>

    <!-- Lilás = ação em curso, item clicável, foco. -->
    <SolidColorBrush x:Key="AccentBorderBrush"       Color="#4D9B51E0"/>
    <SolidColorBrush x:Key="AccentBorderStrongBrush" Color="#669B51E0"/>
    <SolidColorBrush x:Key="AccentFocusBrush"        Color="#739B51E0"/>

    <SolidColorBrush x:Key="DangerBorderBrush"      Color="#59E5484D"/>
    <SolidColorBrush x:Key="DangerBorderHovBrush"   Color="#8CE5484D"/>
    <SolidColorBrush x:Key="WarnBorderBrush"        Color="#52E28743"/>
    <SolidColorBrush x:Key="MagentaBorderBrush"     Color="#57D53F8C"/>

    <!-- ══════════════════════════════════════════════════════════════════
         TEXTO
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="TextStrongBrush"       Color="#FFF5F4F7"/>
    <SolidColorBrush x:Key="TextNormalBrush"       Color="#FFE8E6EC"/>
    <SolidColorBrush x:Key="TextBodyBrush"         Color="#FFCBC8D1"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#FF8B8794"/>
    <SolidColorBrush x:Key="TextMutedBrush"        Color="#FF6F6A7A"/>

    <SolidColorBrush x:Key="AccentLilacBrush"      Color="#FFC79EF0"/>
    <SolidColorBrush x:Key="AccentLilacHoverBrush" Color="#FFD9BCFF"/>
    <SolidColorBrush x:Key="SuccessBrush"          Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="#FFE5484D"/>
    <SolidColorBrush x:Key="DangerTextBrush"       Color="#FFFF8A8D"/>
    <SolidColorBrush x:Key="DangerHoverBrush"      Color="#FFF05257"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#FFE28743"/>
    <SolidColorBrush x:Key="MagentaBrush"          Color="#FFD53F8C"/>

    <!-- ══════════════════════════════════════════════════════════════════
         PREENCHIMENTOS DE ESTADO
         Fundos translúcidos que aparecem repetidos nas duas specs.
         ══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="AccentFill08Brush"  Color="#149B51E0"/>  <!-- hover de item de arquivo -->
    <SolidColorBrush x:Key="AccentFill10Brush"  Color="#1A9B51E0"/>  <!-- hover de botão outline -->
    <SolidColorBrush x:Key="AccentFill12Brush"  Color="#1F9B51E0"/>  <!-- aba ativa, caixa de ícone -->
    <SolidColorBrush x:Key="AccentFill14Brush"  Color="#249B51E0"/>  <!-- pill de nível -->
    <SolidColorBrush x:Key="AccentRing25Brush"  Color="#409B51E0"/>  <!-- anel do spinner -->
    <SolidColorBrush x:Key="AccentEdge24Brush"  Color="#3D9B51E0"/>  <!-- borda da caixa de ícone -->
    <SolidColorBrush x:Key="AccentEdge28Brush"  Color="#479B51E0"/>  <!-- círculo do estado vazio -->

    <SolidColorBrush x:Key="DangerFill12Brush"  Color="#1FE5484D"/>  <!-- marcador destrutivo do log -->
    <SolidColorBrush x:Key="DangerFill14Brush"  Color="#24E5484D"/>  <!-- pill "Ação destrutiva" -->
    <SolidColorBrush x:Key="DangerFill16Brush"  Color="#29E5484D"/>  <!-- hover do botão fechar -->
    <SolidColorBrush x:Key="DangerEdge32Brush"  Color="#52E5484D"/>  <!-- borda da pill destrutiva -->

    <SolidColorBrush x:Key="WarnFill10Brush"    Color="#1AE28743"/>  <!-- faixa de contexto cheio -->
    <SolidColorBrush x:Key="WarnEdge45Brush"    Color="#73E28743"/>  <!-- botão "Compactar" -->
    <SolidColorBrush x:Key="MagentaFill10Brush" Color="#1AD53F8C"/>  <!-- faixa de reconexão -->
    <SolidColorBrush x:Key="ReadFill05Brush"    Color="#0DFFFFFF"/>  <!-- marcador de leitura no log -->

    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbTrackBrush" Color="#2EFFFFFF"/>

    <!-- Trilho do switch desligado. -->
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SwitchKnobOffBrush"  Color="#FFCBC8D1"/>
    <SolidColorBrush x:Key="SwitchKnobOnBrush"   Color="#FFFFFFFF"/>

    <!-- ══════════════════════════════════════════════════════════════════
         GRADIENTES
         A moldura neon é a ÚNICA cor saturada da janela. Chat O2 /
         Configurações O3.
         ══════════════════════════════════════════════════════════════════ -->

    <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="0.35"/>
        <GradientStop Color="#D53F8C" Offset="0.65"/>
        <GradientStop Color="#E28743" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- Bolha do usuário, botão Salvar, botão enviar, switch ligado. -->
    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- Moldura da barra de input do chat: três paradas, não quatro. -->
    <LinearGradientBrush x:Key="InputFrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9B51E0" Offset="0.00"/>
        <GradientStop Color="#3182CE" Offset="0.55"/>
        <GradientStop Color="#D53F8C" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- ══════════════════════════════════════════════════════════════════
         SOMBRAS
         A moldura externa PRECISA da sombra: sem ela a janela não lê como
         flutuante sobre o desktop. Chat O3 / Configurações O4.
         A bolha do USUÁRIO não tem sombra nem glow — Chat O5.
         ══════════════════════════════════════════════════════════════════ -->

    <DropShadowEffect x:Key="WindowShadow"  BlurRadius="60" ShadowDepth="15"
                      Direction="270" Opacity="0.55" Color="Black"/>
    <DropShadowEffect x:Key="CardShadow"    BlurRadius="8"  ShadowDepth="2"
                      Direction="270" Opacity="0.20" Color="Black"/>
    <DropShadowEffect x:Key="TooltipShadow" BlurRadius="18" ShadowDepth="6"
                      Direction="270" Opacity="0.45" Color="Black"/>
    <DropShadowEffect x:Key="SendGlow"      BlurRadius="16" ShadowDepth="4"
                      Direction="270" Opacity="0.35" Color="#9B51E0"/>

    <!-- ══════════════════════════════════════════════════════════════════
         RAIOS
         ══════════════════════════════════════════════════════════════════ -->

    <CornerRadius x:Key="RadiusWindowOuter">20</CornerRadius>
    <CornerRadius x:Key="RadiusWindowInner">18.5</CornerRadius>
    <!-- Raio UNIFORME. Não voltar ao canto "rabinho" de balão: a geometria é
         de card, herdada da tela de seleção. Chat O4. -->
    <CornerRadius x:Key="RadiusBubble">18</CornerRadius>
    <CornerRadius x:Key="RadiusChip">18</CornerRadius>
    <CornerRadius x:Key="RadiusInputFrame">18</CornerRadius>
    <CornerRadius x:Key="RadiusInputInner">16.5</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusCardLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusButton">10</CornerRadius>
    <CornerRadius x:Key="RadiusIconBtn">8</CornerRadius>
    <CornerRadius x:Key="RadiusTooltip">8</CornerRadius>
    <CornerRadius x:Key="RadiusCodeBlock">12</CornerRadius>
    <CornerRadius x:Key="RadiusCodeInline">5</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>
    <CornerRadius x:Key="RadiusSwitch">20</CornerRadius>

    <!-- ══════════════════════════════════════════════════════════════════
         TIPOGRAFIA
         Família UI = Segoe UI, o default do WPF: não declarar fonte custom.
         Mono só nos valores técnicos que o usuário confere caractere por
         caractere. Configurações A10.
         ══════════════════════════════════════════════════════════════════ -->

    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSizeHeaderTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeHeaderSub">12.5</sys:Double>
    <sys:Double x:Key="FontSizeAgentName">16</sys:Double>
    <sys:Double x:Key="FontSizeBubble">14</sys:Double>
    <sys:Double x:Key="FontSizeField">13</sys:Double>
    <sys:Double x:Key="FontSizeControl">12.5</sys:Double>
    <sys:Double x:Key="FontSizeControlMono">12</sys:Double>
    <sys:Double x:Key="FontSizeTool">12</sys:Double>
    <sys:Double x:Key="FontSizeToolArg">11</sys:Double>
    <sys:Double x:Key="FontSizePill">11</sys:Double>
    <sys:Double x:Key="FontSizeHelp">11</sys:Double>
    <sys:Double x:Key="FontSizeSection">10</sys:Double>
    <sys:Double x:Key="FontSizeStamp">10.5</sys:Double>
    <sys:Double x:Key="FontSizeCode">12.5</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════════
         GEOMETRIA
         ══════════════════════════════════════════════════════════════════ -->

    <sys:Double x:Key="ChatWindowWidth">770</sys:Double>
    <sys:Double x:Key="ChatWindowHeight">520</sys:Double>
    <sys:Double x:Key="PanelWindowWidth">300</sys:Double>
    <sys:Double x:Key="SettingsWindowWidth">620</sys:Double>
    <sys:Double x:Key="SettingsWindowHeight">560</sys:Double>

    <sys:Double x:Key="HeaderHeight">52</sys:Double>
    <sys:Double x:Key="IconButtonSize">34</sys:Double>
    <sys:Double x:Key="RecordButtonSize">38</sys:Double>
    <sys:Double x:Key="InputHeight">49</sys:Double>
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="ControlColumnWidth">210</sys:Double>
    <!-- A mesma medida como GridLength. ColumnDefinition.Width não aceita Double:
         ligar o token de cima ali estoura como XamlParseException na abertura da
         tela, não na compilação. -->
    <GridLength x:Key="ControlColumnGrid">210</GridLength>
    <sys:Double x:Key="ChipMinHeight">41</sys:Double>
    <!-- 5 ícones de 22px + 4 vãos de 8px. A barra de 4px é o único aviso de
         que há mais ações fora de vista: o contador "+N" foi implementado e
         removido de propósito. Chat A11. -->
    <sys:Double x:Key="IconTrackMaxWidth">142</sys:Double>
    <sys:Double x:Key="ActionIconSize">22</sys:Double>
    <sys:Double x:Key="TooltipBlockWidth">340</sys:Double>
    <sys:Double x:Key="TooltipRawMaxHeight">118</sys:Double>
    <sys:Double x:Key="LogDotSize">25</sys:Double>
    <sys:Double x:Key="FileTypeIconSize">26</sys:Double>

</ResourceDictionary>
