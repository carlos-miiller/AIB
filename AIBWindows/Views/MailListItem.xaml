<UserControl x:Class="AIB.Views.MailListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AIB.Ui"
             Cursor="Hand"
             MouseLeftButtonUp="Item_Click">

    <!--
        O item de e-mail das TRÊS telas: a pilha do orbe (shadow-assistant §4.8), a
        lista da área central (tela-chat-v3 §3.10) e o que restar do painel.

        A spec manda reusar o mesmo controle, e a razão é dura: são o mesmo dado com
        a mesma leitura de relance, e duas cópias divergiriam na primeira correção
        feita só de um lado.

        As diferenças vivem em PROPRIEDADES:
          CornerRadius     12 no orbe, 14 no painel;
          RealceLilas      hover lilás no painel; no orbe o item não tem hover;
          EscalaDeJanela   medidas de janela em vez de medidas de 252px;
          MostrarMetadados a linha de data/tamanho/vez — só onde há largura;
          Aberto           o acordeão de §3.10.
    -->

    <UserControl.Resources>
        <ui:UrgenciaConverter x:Key="CorDaUrgencia"    Modo="Cor"/>
        <ui:UrgenciaConverter x:Key="FundoDaUrgencia"  Modo="Fundo"/>
        <ui:UrgenciaConverter x:Key="RotuloDaUrgencia" Modo="Rotulo"/>
        <ui:MaiusculaConverter x:Key="EmMaiuscula"/>

        <!-- AÇÃO DO CORPO. Duas, com a mesma geometria: a primária em lilás traz o
             e-mail para dentro do chat; a secundária, apagada, leva para fora do app.
             A hierarquia de cor é o que diz qual é o caminho principal. -->
        <Style x:Key="AcaoDoCorpo" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentLilacBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Casca" CornerRadius="9"
                                Background="Transparent"
                                BorderBrush="{StaticResource AccentBorderStrongBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Casca" Property="Background"
                                        Value="{StaticResource AccentFill12Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AcaoSecundariaDoCorpo" TargetType="Button" BasedOn="{StaticResource AcaoDoCorpo}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Casca" CornerRadius="9"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderCardBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Casca" Property="Background"
                                        Value="{StaticResource SurfaceHoverSoftBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBodyBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Casca"
            BorderThickness="1"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="9,9,11,10"/>
                <Setter Property="Background" Value="{StaticResource ReadFill05Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Style.Triggers>
                    <!-- Escala de JANELA: mais respiro, porque a largura passou de 252px
                         para a da janela inteira. -->
                    <DataTrigger Binding="{Binding EscalaDeJanela, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Padding" Value="12,12,14,12"/>
                    </DataTrigger>

                    <!-- O hover é do PAINEL e da LISTA. No orbe o item não reage ao
                         mouse: lá a pilha é leitura de passagem, e um realce a cada
                         item sob o cursor viraria ruído sobre o desktop. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RealceLilas, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource AccentFill08Brush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderStrongBrush}"/>
                    </MultiDataTrigger>

                    <!-- ABERTO vence o hover: o item que está aberto fica marcado mesmo
                         com o cursor noutro lugar da lista. -->
                    <DataTrigger Binding="{Binding Aberto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentFill08Brush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderStrongBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- nome + selo -->
                <RowDefinition Height="Auto"/>   <!-- metadados    -->
                <RowDefinition Height="Auto"/>   <!-- resumo       -->
                <RowDefinition Height="Auto"/>   <!-- corpo        -->
            </Grid.RowDefinitions>

            <!-- A barra de urgência é o que se lê de relance, antes de qualquer texto. -->
            <Border Grid.Column="0" Grid.RowSpan="4"
                    Width="3" CornerRadius="2"
                    Background="{Binding Urgency, Converter={StaticResource CorDaUrgencia}}"/>

            <TextBlock x:Name="NomeTexto" Grid.Column="1" Grid.Row="0"
                       Margin="10,0,0,0"
                       Text="{Binding Name}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextStrongBrush}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EscalaDeJanela, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="FontSize" Value="13.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- LINHA DE METADADOS. Uma linha só, "·" como separador. A vez tem cor
                 própria: "Nova mensagem" é o único pedaço da linha que pede ação, e
                 lê-lo em cinza junto do resto o esconderia.
                 SOME quando o item está aberto — o corpo já traz remetente e hora. -->
            <StackPanel x:Name="LinhaDeMetadados" Grid.Column="1" Grid.Row="1"
                        Orientation="Horizontal" Margin="10,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <!-- Nasce do Style e não de um Visibility local: valor local vence
                             trigger, e a linha nunca apareceria. -->
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding MostrarMetadados, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                    <Condition Binding="{Binding Aberto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock x:Name="MetadadosTexto"
                           FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text=" · " FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="VezTexto"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentLilacBrush}"/>
            </StackPanel>

            <!-- A13 — o resumo vem da IA e pode vir longo. Duas linhas e ponto: sem o
                 teto, o balão estica e cobre a tela.
                 ABERTO, ele sai: o corpo traz o resumo inteiro, e mantê-lo aqui
                 repetiria a primeira frase duas vezes na mesma caixa. -->
            <TextBlock x:Name="ResumoTexto" Grid.Column="1" Grid.Row="2"
                       Margin="10,3,0,0"
                       Text="{Binding Description}"
                       LineHeight="16.7"
                       MaxHeight="34"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EscalaDeJanela, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="MaxHeight" Value="36"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Aberto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- A12 — a cor é o sinal de relance, mas o rótulo de texto fica junto:
                 daltonismo e captura de tela em tons de cinza. -->
            <Border Grid.Column="2" Grid.Row="0"
                    Margin="10,0,0,0"
                    Padding="6,3,8,3"
                    VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusPill}"
                    Background="{Binding Urgency, Converter={StaticResource FundoDaUrgencia}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5"
                             VerticalAlignment="Center"
                             Fill="{Binding Urgency, Converter={StaticResource CorDaUrgencia}}"/>
                    <TextBlock Margin="5,0,0,0"
                               Text="{Binding Urgency, Converter={StaticResource RotuloDaUrgencia}}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding Urgency, Converter={StaticResource CorDaUrgencia}}"/>
                </StackPanel>
            </Border>

            <!-- ── O CORPO DO ACORDEÃO (§3.10) ──────────────────────────────
                 Cursor de seta: aqui dentro não se clica para fechar, se lê. -->
            <StackPanel x:Name="Corpo" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                        Margin="10,10,0,0" Cursor="Arrow">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Aberto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                <TextBlock x:Name="RemetenteTexto"
                           FontSize="10.5" Margin="0,0,0,8"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <TextBlock x:Name="RotuloDoResumo"
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,5"
                           Foreground="{StaticResource AccentLilacBrush}">
                    <Run Text="RESUMO DA "/><Run Text="{Binding NomeDaInteligencia,
                         RelativeSource={RelativeSource AncestorType=UserControl},
                         Converter={StaticResource EmMaiuscula}}"/>
                </TextBlock>

                <!-- Sem teto de linhas: é o resumo COMPLETO, e cortá-lo aqui deixaria
                     o usuário sem nenhum lugar onde ler o texto inteiro. -->
                <TextBlock Text="{Binding Description}"
                           FontSize="12" LineHeight="18.6"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBodyBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BotaoAbrirComIA"
                            Style="{StaticResource AcaoDoCorpo}"
                            Click="AbrirComIA_Click">
                        <TextBlock>
                            <!-- Dois Run, e NUNCA a string inteira: o nome vem da
                                 personalidade ativa e muda com ela. -->
                            <Run Text="Abrir com "/><Run Text="{Binding NomeDaInteligencia,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </TextBlock>
                    </Button>

                    <Button x:Name="BotaoAbrirNoCliente"
                            Margin="8,0,0,0"
                            Style="{StaticResource AcaoSecundariaDoCorpo}"
                            Content="{Binding RotuloDoCliente,
                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Click="AbrirNoCliente_Click"/>

                    <!-- IGNORAR: tira a conversa da lista até chegar mensagem nova.
                         Texto e geometria da secundária — é arrumação, não saída do app
                         nem destruição. Nasce recolhido: só aparece onde há quem guarde
                         o que foi ignorado (a lista da área central, não o orbe). -->
                    <Button x:Name="BotaoIgnorar"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Style="{StaticResource AcaoSecundariaDoCorpo}"
                            Content="Ignorar"
                            ToolTip="Tirar da lista até chegar mensagem nova nesta conversa"
                            Click="Ignorar_Click"/>

                    <!-- DESCARTAR a conversa com a IA sobre este e-mail.
                         Só ícone, e com a geometria da secundária: é a única ação do
                         corpo sem desfazer, e um terceiro rótulo do mesmo peso convida
                         ao clique errado — o mesmo raciocínio do botão da leitura (§3.11).
                         Nasce recolhido: sem conversa havida, não há o que descartar. -->
                    <Button x:Name="BotaoDescartarConversa"
                            Margin="8,0,0,0" Width="30" Padding="0"
                            Visibility="Collapsed"
                            Style="{StaticResource AcaoSecundariaDoCorpo}"
                            ToolTip="Descartar a conversa sobre este e-mail"
                            Click="DescartarConversa_Click">
                        <Path Data="M4.6,5.8 H15.4 M8.2,5.8 V4.4 A0.9,0.9 0 0 1 9.1,3.5
                                    H10.9 A0.9,0.9 0 0 1 11.8,4.4 V5.8
                                    M6.1,5.8 L6.8,15.6 A1,1 0 0 0 7.8,16.5
                                    H12.2 A1,1 0 0 0 13.2,15.6 L13.9,5.8
                                    M8.6,8.4 V13.6 M11.4,8.4 V13.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
