<Window x:Class="AIB.Views.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AIB.Ui"
        xmlns:v="clr-namespace:AIB.Views"
        Title="AIB — Painel"
        Width="350" Height="605"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        §6 — PAINEL LATERAL, segunda janela flutuante de 300x520.

        Mesma moldura, mesmo vidro e mesma sombra da janela de chat, alinhado
        pela BASE. A janela do WPF é maior que o desenho porque a DropShadow
        precisa de área: 350-40-10 = 300 e 605-25-60 = 520.
    -->
    <Window.Resources>

        <!-- Aba: ícone só. A ativa recebe lilás e fundo lilás a 12%. -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Casca" Background="Transparent"
                                CornerRadius="{StaticResource RadiusIconBtn}"
                                Padding="8" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Casca" Property="Background"
                                        Value="{StaticResource SurfaceHoverSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Casca" Property="Background"
                                        Value="{StaticResource AccentFill12Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentLilacBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Casca de item de lista: card com hover lilás. -->
        <Style x:Key="ItemCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderStrongBrush}"/>
                    <Setter Property="Background" Value="{StaticResource AccentFill08Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ItemMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="VazioTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,28,0,0"/>
        </Style>

        <!-- E6/A16 — o painel dá 269px úteis e o rodapé de e-mails leva TRÊS
             medidas. Sem NoWrap ele quebra em duas linhas e a base dos quatro
             rodapés deixa de coincidir ao trocar de aba; sem MinHeight, a aba de
             uma medida só fica mais baixa que a de três. Os rótulos são curtos de
             propósito: não reescrever para "importantes" nem "tokens em contexto". -->
        <Style x:Key="RodapeTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>
    </Window.Resources>

    <Border Margin="0,25,40,60"
            Width="300"
            Background="{StaticResource NeonBrush}"
            CornerRadius="{StaticResource RadiusWindowOuter}"
            Padding="1.5"
            Effect="{StaticResource WindowShadow}">

        <Border Background="{StaticResource GlassBrush}"
                CornerRadius="{StaticResource RadiusWindowInner}"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── CABEÇALHO ───────────────────────────────────────── -->
                <Grid Grid.Row="0" Height="{StaticResource HeaderHeight}"
                      Background="Transparent"
                      MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown"
                      MouseMove="Cabecalho_MouseMove"
                      MouseLeftButtonUp="Cabecalho_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Painel" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextStrongBrush}"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>

                    <Button Grid.Column="1" Style="{StaticResource CloseIconButton}"
                            Margin="0,0,10,0" Click="Fechar_Click" ToolTip="Fechar painel">
                        <Path Data="M5,5 L13,13 M13,5 L5,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="None"/>
                    </Button>

                    <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                               Fill="{StaticResource DividerBrush}"/>
                </Grid>

                <!-- ── BARRA DE 3 ABAS ───────────────────────────────────
                     Histórico | Arquivos | Ações. E-MAILS SAIU: ele virou o modo
                     e-mail da área central (tela-chat-v3 §3.10/§3.11), onde tem
                     largura de janela para o acordeão e a leitura com a IA. Duas
                     portas para a mesma caixa acabariam divergindo, e a de 252px
                     era a pior das duas. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,12,14,6">

                    <RadioButton x:Name="AbaHistorico" Style="{StaticResource PanelTab}"
                                 IsChecked="True" Checked="Aba_Checked" ToolTip="Histórico de chats">
                        <Path Data="M9,2.2 A6.8,6.8 0 1 1 9,15.8 A6.8,6.8 0 1 1 9,2.2 Z M9,5.4 V9 L11.6,10.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="None"/>
                    </RadioButton>

                    <RadioButton x:Name="AbaArquivos" Style="{StaticResource PanelTab}"
                                 Checked="Aba_Checked" ToolTip="Arquivos no contexto">
                        <Path Data="M2.4,5.2 A1.2,1.2 0 0 1 3.6,4 H7.4 L9,5.8 H14.4 A1.2,1.2 0 0 1 15.6,7 V13.4 A1.2,1.2 0 0 1 14.4,14.6 H3.6 A1.2,1.2 0 0 1 2.4,13.4 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.4" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="None"/>
                    </RadioButton>

                    <RadioButton x:Name="AbaAcoes" Style="{StaticResource PanelTab}"
                                 Checked="Aba_Checked" ToolTip="Histórico de ações">
                        <Path Data="M3.4,4.6 H14.6 M3.4,9 H14.6 M3.4,13.4 H10.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="None"/>
                    </RadioButton>
                </StackPanel>

                <!-- ── PANE ATIVA ──────────────────────────────────────── -->
                <Grid Grid.Row="2" Margin="14,0,14,12">

                    <!-- ═══ §6.1  HISTÓRICO DE CHATS ═══════════════════ -->
                    <Grid x:Name="PaneHistorico">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Linha de título com altura MÍNIMA fixa: sem ela o título
                             pula de altura ao trocar de aba, porque só uma pane tem
                             botão do lado direito (A8). -->
                        <Grid MinHeight="27" Margin="0,0,0,8">
                            <TextBlock Text="Histórico de chats" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       ui:LetterSpacing.Em="0.02"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ListaHistorico"/>
                                <TextBlock x:Name="HistoricoVazio" Text="Nenhum chat salvo."
                                           Style="{StaticResource VazioTexto}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- E10 — o peso é chat + capítulos + atos, não só o arquivo de
                             mensagens: quem some do disco na exclusão é o conjunto. Some
                             junto com a lista quando não há chat salvo. -->
                        <StackPanel x:Name="HistoricoRodapeCaixa" Grid.Row="2" Margin="0,8,0,0">
                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="HistoricoRodape" Style="{StaticResource RodapeTexto}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ §6.3  ARQUIVOS NO CONTEXTO ═════════════════ -->
                    <Grid x:Name="PaneArquivos" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid MinHeight="27" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Arquivos no contexto" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Grid.Column="1" Content="+ Adicionar"
                                    Click="Adicionar_Click"
                                    FontSize="11.5" FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentLilacBrush}"
                                    Background="Transparent" Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Casca" Background="Transparent"
                                                BorderBrush="{StaticResource AccentBorderStrongBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="9,4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Casca" Property="Background"
                                                        Value="{StaticResource AccentFill12Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ListaArquivos"/>
                                <TextBlock x:Name="ArquivosVazio" Text="Nenhum arquivo no contexto."
                                           Style="{StaticResource VazioTexto}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ArquivosRodape" Style="{StaticResource RodapeTexto}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ §6.3  HISTÓRICO DE AÇÕES ═══════════════════ -->
                    <Grid x:Name="PaneAcoes" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid MinHeight="27" Margin="0,0,0,8">
                            <TextBlock Text="Histórico de ações" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="ListaAcoes"/>
                                <TextBlock x:Name="AcoesVazio" Text="Nenhuma ação registrada."
                                           Style="{StaticResource VazioTexto}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AcoesRodape" Style="{StaticResource RodapeTexto}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
