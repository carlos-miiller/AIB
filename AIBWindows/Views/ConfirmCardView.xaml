<UserControl x:Class="AIB.Views.ConfirmCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">

    <!--
        §5.3 — CONFIRMAR AÇÃO DESTRUTIVA.

        Casca IDÊNTICA à bolha da IA, com borda NEUTRA. O alerta vem do
        conteúdo — pill, título e botão vermelho —, não da moldura. Uma borda
        vermelha faria o card gritar antes de o usuário ler o que ele diz.
    -->
    <Border x:Name="Casca" MaxWidth="560"
            Padding="18,16"
            CornerRadius="{StaticResource RadiusBubble}"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <StackPanel>

            <!-- (a) PILL — geometria da pill de nível, em vermelho. -->
            <Border x:Name="Pill" Style="{StaticResource PillBorder}"
                    Background="{StaticResource DangerFill14Brush}"
                    BorderBrush="{StaticResource DangerEdge32Brush}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="PillIcone" Data="M6,1 L11.5,10.5 L0.5,10.5 Z M6,4.6 L6,7.4 M6,8.8 L6,9.2"
                          Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="12" Height="11" Stretch="None"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PillTexto" Text="Ação destrutiva" Style="{StaticResource PillText}"
                               Foreground="{StaticResource DangerTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- SELO "SHADOW": o pedido veio da conversa do orbe. Só na janela flutuante
                 (ParaFlutuante); dentro da conversa não há dúvida de onde veio. -->
            <Border x:Name="SeloShadow" Style="{StaticResource PillBorder}"
                    Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                    Background="{StaticResource AccentFill08Brush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    ToolTip="Pedido pela conversa do orbe">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentLilacBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Shadow" Style="{StaticResource PillText}"
                               Foreground="{StaticResource TextStrongBrush}"/>
                </StackPanel>
            </Border>

            <!-- (b) TÍTULO em forma de PERGUNTA. -->
            <TextBlock x:Name="TituloText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextStrongBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <!-- (c) SUBTÍTULO com a consequência real. -->
            <TextBlock x:Name="ConsequenciaText" FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"/>

            <!-- (d) CAIXA DO ALVO. -->
            <Border Background="{StaticResource SurfaceCodeBrush}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="12,10" Margin="0,12,0,0">
                <!-- Grade, e não StackPanel horizontal: o alvo recebe a largura que sobra e QUEBRA
                     linha. Antes era uma linha cortada em 330 px com "…", e o texto inteiro só no
                     tooltip — uma linha sem fim que atravessava a tela (visto em 15/10 com uma
                     anotação do navegador). O cartão existe para o usuário ler o que autoriza:
                     anotação e comando vão inteiros, com rolagem se passarem da altura. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="IconeAlvo"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FerramentaText" Grid.Column="1"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Top" Margin="0,3,10,0"/>
                    <ScrollViewer Grid.Column="2" MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="AlvoText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12" LineHeight="17"
                                   Foreground="{StaticResource TextBodyBrush}"
                                   TextWrapping="Wrap" Margin="0,3,8,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PRÉVIA do que vai ser gravado: o conteúdo do write, o antes e depois do edit.
                 Mesma caixa do alvo, com altura contida — um arquivo longo rola aqui dentro em
                 vez de empurrar os botões para fora da tela. Só aparece quando há prévia. -->
            <Border x:Name="PreviaBorder" Visibility="Collapsed"
                    Background="{StaticResource SurfaceCodeBrush}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="12,10" Margin="0,8,0,0">
                <ScrollViewer MaxHeight="140"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviaText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5" LineHeight="17"
                               Foreground="{StaticResource TextBodyBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- PLANO DE GRAVAÇÃO de documento (ferramenta doc): resumo, contagens, a tabela de
                 antes e depois, o efeito nas fórmulas, os avisos e a cópia. Montado em código
                 (ConfirmCardView.Plano.cs); no lugar da prévia em texto. -->
            <StackPanel x:Name="PlanoPanel" Visibility="Collapsed">
                <TextBlock x:Name="PlanoResumoText" FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <WrapPanel x:Name="PlanoContagens" Margin="0,6,0,0"/>
                <Border x:Name="PlanoTabelaBorder" Visibility="Collapsed"
                        Background="{StaticResource SurfaceCodeBrush}"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="0,4" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PlanoTabela" Margin="10,0"/>
                    </ScrollViewer>
                </Border>
                <ScrollViewer x:Name="PlanoEfeitosScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel x:Name="PlanoEfeitos"/>
                </ScrollViewer>
                <ScrollViewer x:Name="PlanoAvisosScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="PlanoAvisos"/>
                </ScrollViewer>
                <TextBlock x:Name="PlanoCopiaText" Visibility="Collapsed"
                           FontSize="11.5" Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap" Margin="0,9,0,0"/>
            </StackPanel>

            <!-- Motivo do bloqueio, quando veio da lista de negação. -->
            <TextBlock x:Name="MotivoText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Texto de e-mail no contexto: o pedido pode ter vindo de terceiros.
                 Mesma forma do motivo de bloqueio, que já é o aviso do card. -->
            <TextBlock x:Name="AvisoEmailText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Há texto de terceiros nesta conversa (e-mail ou página da web). Se você não pediu esta ação, ela pode ter vindo de instruções escritas nesse texto — confira antes de permitir."/>

            <!-- Caminho fora das pastas de confiança: o shell não é limitado pela lista, então
                 o que dá para fazer é contar antes de o usuário permitir. -->
            <TextBlock x:Name="AvisoPastaText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Aliases do cofre no comando: o nome, para que serve e os endereços permitidos.
                 O valor nunca aparece aqui; entra no processo só depois do Permitir. -->
            <Border x:Name="CofreBorder" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{StaticResource AccentFill08Brush}"
                    BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Usa o cofre" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentLilacBrush}"/>
                    <TextBlock x:Name="CofreText" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource TextStrongBrush}"/>
                </StackPanel>
            </Border>

            <!-- (e) RODAPÉ separado por divisória. -->
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16,0,0"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PermitirButton" Grid.Column="0" Content="Permitir"
                        Style="{StaticResource DangerFilledButton}"
                        Click="Permitir_Click" Margin="0,0,10,0"/>

                <Button x:Name="RecusarButton" Grid.Column="1" Content="Recusar"
                        Style="{StaticResource OutlineButton}" Padding="18,8"
                        Click="Recusar_Click"/>

                <!-- Grade, e não StackPanel horizontal: o StackPanel mede o rótulo com largura
                     infinita, e o rótulo longo ("...neste site (segure 5 s)") não cabia no que
                     sobrava do cartão — saía por cima dos botões. Aqui o rótulo recebe a largura
                     que há e quebra linha. -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SempreCheck" VerticalAlignment="Center" HorizontalAlignment="Right"
                              Foreground="{StaticResource TextMutedBrush}"
                              FontSize="11" Margin="0,0,12,0"
                              Content="Sempre permitir este comando">
                        <CheckBox.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </CheckBox.ContentTemplate>
                    </CheckBox>
                    <TextBlock x:Name="DicaText" Grid.Column="1" Text="execução pausada"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
