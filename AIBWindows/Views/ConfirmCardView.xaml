<UserControl x:Class="AIB.Views.ConfirmCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">

    <!--
        §5.3 — CONFIRMAR AÇÃO DESTRUTIVA.

        Casca IDÊNTICA à bolha da IA, com borda NEUTRA. O alerta vem do
        conteúdo — pill, título e botão vermelho —, não da moldura. Uma borda
        vermelha faria o card gritar antes de o usuário ler o que ele diz.
    -->
    <Border MaxWidth="560"
            Padding="18,16"
            CornerRadius="{StaticResource RadiusBubble}"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1"
            Effect="{StaticResource CardShadow}">
        <StackPanel>

            <!-- (a) PILL — geometria da pill de nível, em vermelho. -->
            <Border Style="{StaticResource PillBorder}"
                    Background="{StaticResource DangerFill14Brush}"
                    BorderBrush="{StaticResource DangerEdge32Brush}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,1 L11.5,10.5 L0.5,10.5 Z M6,4.6 L6,7.4 M6,8.8 L6,9.2"
                          Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="12" Height="11" Stretch="None"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Ação destrutiva" Style="{StaticResource PillText}"
                               Foreground="{StaticResource DangerTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- (b) TÍTULO em forma de PERGUNTA. -->
            <TextBlock x:Name="TituloText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextStrongBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <!-- (c) SUBTÍTULO com a consequência real. -->
            <TextBlock x:Name="ConsequenciaText" FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"/>

            <!-- (d) CAIXA DO ALVO. -->
            <Border Background="{StaticResource SurfaceCodeBrush}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="12,10" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="IconeAlvo"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="22" Height="22" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FerramentaText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AlvoText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource TextBodyBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="330"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- PRÉVIA do que vai ser gravado: o conteúdo do write, o antes e depois do edit.
                 Mesma caixa do alvo, com altura contida — um arquivo longo rola aqui dentro em
                 vez de empurrar os botões para fora da tela. Só aparece quando há prévia. -->
            <Border x:Name="PreviaBorder" Visibility="Collapsed"
                    Background="{StaticResource SurfaceCodeBrush}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="12,10" Margin="0,8,0,0">
                <ScrollViewer MaxHeight="140"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviaText"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5" LineHeight="17"
                               Foreground="{StaticResource TextBodyBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Motivo do bloqueio, quando veio da lista de negação. -->
            <TextBlock x:Name="MotivoText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Texto de e-mail no contexto: o pedido pode ter vindo de terceiros.
                 Mesma forma do motivo de bloqueio, que já é o aviso do card. -->
            <TextBlock x:Name="AvisoEmailText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Há texto de terceiros nesta conversa (e-mail ou página da web). Se você não pediu esta ação, ela pode ter vindo de instruções escritas nesse texto — confira antes de permitir."/>

            <!-- Caminho fora das pastas de confiança: o shell não é limitado pela lista, então
                 o que dá para fazer é contar antes de o usuário permitir. -->
            <TextBlock x:Name="AvisoPastaText" Visibility="Collapsed"
                       FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- (e) RODAPÉ separado por divisória. -->
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16,0,0"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PermitirButton" Grid.Column="0" Content="Permitir"
                        Style="{StaticResource DangerFilledButton}"
                        Click="Permitir_Click" Margin="0,0,10,0"/>

                <Button x:Name="RecusarButton" Grid.Column="1" Content="Recusar"
                        Style="{StaticResource OutlineButton}" Padding="18,8"
                        Click="Recusar_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="SempreCheck" VerticalAlignment="Center"
                              Foreground="{StaticResource TextMutedBrush}"
                              FontSize="11" Margin="0,0,12,0"
                              Content="Sempre permitir este comando"/>
                    <TextBlock x:Name="DicaText" Text="execução pausada"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
