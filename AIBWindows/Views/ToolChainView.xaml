<UserControl x:Class="AIB.Views.ToolChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">

    <!--
        §4 — CADEIA DE AÇÕES.

        Tudo numa linha só: as concluídas colapsam num único chip de ícones à
        esquerda, e a em curso fica à direita dele. MaxWidth 90% é da CADEIA,
        não do chip; o chip concluído cresce a cada ação e nunca é comprimido.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ── §4.3  CHIP CONCLUÍDO ────────────────────────────────────────
             Nasce recolhido e só aparece quando a primeira ação termina. -->
        <Border x:Name="ChipConcluido"
                Visibility="Collapsed"
                MinHeight="{StaticResource ChipMinHeight}"
                Padding="14,7"
                CornerRadius="{StaticResource RadiusChip}"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderCardBrush}"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Check verde de 12px. -->
                <Path Data="M1,6.4 L4.4,9.8 L11,2.6"
                      Stroke="{StaticResource SuccessBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="None"
                      VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- ── §4.4  TRILHA DE ÍCONES ──────────────────────────────
                     No máximo 5 visíveis: 5 x 22 + 4 x 8 = 142. A barra de 5px
                     é o ÚNICO aviso de que há mais ações fora de vista — o
                     contador "+N" foi implementado e removido de propósito,
                     não readicionar (A11). -->
                <ScrollViewer x:Name="TrilhaScroll"
                              MaxWidth="{StaticResource IconTrackMaxWidth}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="Trilha_PreviewMouseWheel"
                              Background="Transparent">
                    <StackPanel x:Name="Trilha" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ── §4.2  CHIP EM EXECUÇÃO ──────────────────────────────────────
             Mesma altura mínima do concluído: alturas diferentes na mesma
             linha desalinham (A10). -->
        <Border x:Name="ChipEmCurso"
                Visibility="Collapsed"
                MinHeight="{StaticResource ChipMinHeight}"
                Padding="14,7"
                CornerRadius="{StaticResource RadiusChip}"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource AccentBorderBrush}"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Spinner: anel de 12px com o topo em lilás, girando. -->
                <Grid x:Name="Spinner" Width="12" Height="12"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="SpinnerGiro" Angle="0"/>
                    </Grid.RenderTransform>
                    <Ellipse Stroke="{StaticResource AccentRing25Brush}" StrokeThickness="1.6"/>
                    <Path Data="M6,0.8 A5.2,5.2 0 0 1 11.2,6"
                          Stroke="{StaticResource AccentLilacBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                </Grid>

                <!-- Ícone de alerta, no lugar do spinner quando a ação falhou. -->
                <Path x:Name="IconeFalha" Visibility="Collapsed"
                      Data="M6.5,1.2 L12.6,11.8 L0.4,11.8 Z M6.5,5 V8.2 M6.5,9.6 V10"
                      Stroke="{StaticResource DangerBrush}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="13" Height="13" Stretch="None"
                      VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBlock x:Name="RotuloEstado" Text="Executando"
                           FontSize="{StaticResource FontSizeTool}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBlock x:Name="NomeFerramenta"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource FontSizeTool}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentLilacBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ArgumentoResumido"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="{StaticResource FontSizeToolArg}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
