<Window x:Class="AIB.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao AIB"
        Width="650"
        SizeToContent="Height"
        MinHeight="550"
        MaxHeight="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutBg" Color="#EE121214" />
        <SolidColorBrush x:Key="SystemBorder" Color="#3FFFFFFF" />
        <SolidColorBrush x:Key="SystemText" Color="#F2F2F5" />
        <SolidColorBrush x:Key="InputBg" Color="#15FFFFFF" />

        <LinearGradientBrush x:Key="AiAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B5BFF" Offset="0"/>
            <GradientStop Color="#6A3BFF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SystemText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- Sombra de flutuação -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                          Color="#000000" Opacity="0.55"/>
    </Window.Effect>

    <!-- Container principal com bordas arredondadas e gradiente -->
    <Border CornerRadius="16" Padding="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9B51E0" Offset="0"/>
                <GradientStop Color="#3182CE" Offset="0.33"/>
                <GradientStop Color="#D53F8C" Offset="0.66"/>
                <GradientStop Color="#E28743" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- Fundo Escuro Interno -->
        <Border CornerRadius="14" Background="#F01A1A1E">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Provider picker -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Branch swap area -->
                    <RowDefinition Height="*"/>    <!-- Row 3: Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Footer buttons -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,40">
                    <TextBlock Text="Bem-vindo ao AIB" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Para começar, escolha o provedor de inteligência artificial que dará vida ao seu agente." FontSize="15" Margin="0,0,0,0" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Row 1: Provider picker -->
                <StackPanel Grid.Row="1" Margin="20,0,20,20">
                    <RadioButton x:Name="OllamaRadio"
                                 GroupName="ProviderGroup"
                                 IsChecked="True"
                                 Margin="0,0,0,25"
                                 Checked="OllamaRadio_Checked">
                        <StackPanel Margin="10,-4,0,0">
                            <TextBlock Text="Ollama (Local)" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="Roda os modelos na sua própria máquina. Total privacidade, sem custos por requisição." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton x:Name="OpenAiRadio"
                                 GroupName="ProviderGroup"
                                 Margin="0,0,0,0"
                                 Checked="OpenAiRadio_Checked">
                        <StackPanel Margin="10,-4,0,0">
                            <TextBlock Text="OpenAI (Nuvem)" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="Conecta aos servidores da OpenAI para modelos de ponta. Requer sua chave de API." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Row 2: Branch swap area -->
                <Grid Grid.Row="2" Margin="20,10,20,20">

                    <!-- Ollama branch -->
                    <StackPanel x:Name="OllamaBranch" Visibility="Visible">
                        <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="20" BorderBrush="#1A1A20" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Modelo de Linguagem" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ModelComboBox"
                                          Height="42" FontSize="14"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.Name="Modelo instalado no Ollama"
                                          SelectionChanged="ModelComboBox_SelectionChanged"/>
                                <ProgressBar x:Name="LoadingProgress"
                                             IsIndeterminate="True"
                                             Height="2"
                                             VerticalAlignment="Bottom"
                                             Margin="0,2,0,0"/>

                                <StackPanel x:Name="OllamaErrorBlock" Visibility="Collapsed" Margin="0,15,0,0">
                                    <TextBlock Text="Ollama não foi detectado em localhost:11434"
                                               Foreground="#D53F8C" FontWeight="SemiBold"
                                               FontSize="14" Margin="0,0,0,4"/>
                                    <TextBlock Text="Certifique-se de que o Ollama está rodando no seu computador."
                                               Opacity="0.7" FontSize="13" Margin="0,0,0,10"/>
                                    <Button x:Name="RetryButton"
                                            Content="Tentar novamente"
                                            Click="RetryButton_Click"
                                            Width="140" Height="36"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource InputBg}"
                                            Foreground="White" BorderBrush="#2A2A30" Cursor="Hand" Margin="0,0,0,10"/>
                                    <TextBlock Margin="0,0,0,4" FontSize="13">
                                        <Hyperlink x:Name="FallbackLink" Foreground="#3182CE" RequestNavigate="FallbackLink_RequestNavigate">Pular e usar configuração padrão</Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock x:Name="FallbackModelDisplay"
                                           Text="Modelo padrão (qwen2.5:7b) selecionado temporariamente."
                                           Visibility="Collapsed" Opacity="0.8"
                                           Foreground="#3182CE" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- OpenAI branch -->
                    <StackPanel x:Name="OpenAiBranch" Visibility="Collapsed">
                        <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="20" BorderBrush="#1A1A20" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Sua Chave da API" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <TextBox x:Name="KeyTextBox" Height="42" FontSize="14" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Chave da API da OpenAI"
                                         LostFocus="KeyTextBox_LostFocus" KeyDown="KeyTextBox_KeyDown"/>
                                <TextBlock Text="* Sua chave será protegida com criptografia DPAPI no cofre do Windows."
                                           Margin="0,8,0,0" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ErrorLabel" Text="Formato de chave inválido (deve começar com sk-)"
                                           Foreground="#D53F8C" FontWeight="SemiBold" FontSize="13"
                                           Visibility="Collapsed" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>

                <!-- Row 4: Footer buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,0">
                    <Button x:Name="CancelButton" Content="Sair" Click="Cancel_Click" IsCancel="True"
                            Width="90" Height="40" FontSize="14"
                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                    <Button x:Name="SaveButton" Content="Continuar" Click="Save_Click" IsDefault="True" IsEnabled="False"
                            Width="120" Height="40" FontSize="14" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AiAccent}" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Border>
</Window>
