<Window x:Class="AIB.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIB.Views"
        Title="Bem-vindo ao AIB"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <local:ValueToStarForegroundConverter x:Key="StarColorConverter"/>
        
        <SolidColorBrush x:Key="FlyoutBg" Color="#EE121214" />
        <SolidColorBrush x:Key="SystemBorder" Color="#3FFFFFFF" />
        <SolidColorBrush x:Key="SystemText" Color="#F2F2F5" />
        <SolidColorBrush x:Key="InputBg" Color="#15FFFFFF" />

        <LinearGradientBrush x:Key="AiAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B51E0" Offset="0"/>
            <GradientStop Color="#3182CE" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SystemText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- Floating panel filling the window with margin for drop shadow -->
    <Grid Margin="40">
        <!-- Floating shadow (Separated to prevent text blur) -->
        <Border CornerRadius="24" Background="Black">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="25" Direction="270" Color="Black" Opacity="0.55"/>
            </Border.Effect>
        </Border>

        <!-- Outer panel: Neon gradient border (NO EFFECTS) -->
        <Border CornerRadius="24" Padding="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9B51E0" Offset="0"/>
                    <GradientStop Color="#3182CE" Offset="0.35"/>
                    <GradientStop Color="#D53F8C" Offset="0.65"/>
                    <GradientStop Color="#E28743" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Inner panel: Smoked glass solid fill -->
            <Border CornerRadius="22.5" Background="#E6121216">
                <Grid Margin="40,40,40,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Content Area -->
                        <RowDefinition Height="Auto"/> <!-- Footer buttons -->
                    </Grid.RowDefinitions>

                    <!-- Passo 1: Boas Vindas -->
                    <Grid x:Name="Step1_Welcome" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Boas-vindas" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" Foreground="White" HorizontalAlignment="Center"/>
                            
                            <TextBlock Text="Este é o seu novo assistente virtual inteligente." FontSize="16" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Ele é capaz de ler e modificar documentos, executar comandos no terminal e automatizar tarefas do seu dia a dia diretamente no seu computador." 
                                       FontSize="14" Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30" MaxWidth="500"/>
                                       
                            <Border Background="#2A1B15" BorderBrush="#D27519" BorderThickness="1" CornerRadius="8" Padding="15" MaxWidth="450" HorizontalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Esta ferramenta está em fase Beta. Ela tem autonomia para executar ações na sua máquina, portanto revise cuidadosamente os planos antes de aprovar comandos sensíveis." 
                                               FontSize="13" Foreground="#E28743" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Passo 2: Seleção de Inteligência (Novo Design) -->
                    <Grid x:Name="Step2_Profile" Visibility="Visible">
                        <StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock Text="Escolha sua Inteligência" FontSize="26" FontWeight="Bold" Foreground="#F5F4F7" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Selecione o agente que vai te acompanhar" FontSize="13" Foreground="#8B8794" HorizontalAlignment="Center" Margin="0"/>
                            </StackPanel>
                            
                            <!-- Agents Carousel -->
                            <ListBox x:Name="AgentsListBox" 
                                     Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     ScrollViewer.PanningMode="HorizontalOnly"
                                     PreviewMouseWheel="AgentsListBox_PreviewMouseWheel">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Height" Value="6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="Transparent">
                                                        <Track Name="PART_Track" IsDirectionReversed="False">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="#26FFFFFF" CornerRadius="3" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,16,0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Width="320" MinHeight="500">
                                                        <!-- Shadow Caster (Separated) -->
                                                        <Border x:Name="ShadowBd" CornerRadius="18" Background="#1B1618">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.20"/>
                                                            </Border.Effect>
                                                        </Border>
                                                        <!-- Content Border -->
                                                        <Border x:Name="Bd" 
                                                                CornerRadius="18" Padding="28,26" 
                                                                Background="#0FE51212" 
                                                                BorderBrush="#14FFFFFF" BorderThickness="1">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <!-- Background = linear-gradient(135deg, rgba(155,81,224,0.16), rgba(49,130,206,0.09)) -->
                                                            <Setter TargetName="Bd" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#289B51E0" Offset="0"/>
                                                                        <GradientStop Color="#163182CE" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8C9B51E0"/>
                                                            <Setter TargetName="ShadowBd" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#9B51E0" Opacity="0.20"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="#F5F4F7" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                
                                                <Border Background="#239B51E0" BorderBrush="#4C9B51E0" BorderThickness="1" CornerRadius="20" Padding="12,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Personality}" FontSize="12" FontWeight="SemiBold" Foreground="#C79EF0" Margin="0"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                                <TextBlock x:Name="DescText" Text="{Binding Description}" FontSize="14" Foreground="#8B8794" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,12"/>
                                                <TextBlock x:Name="SpeechText" Text="{Binding SampleSpeech}" FontSize="14" FontStyle="Italic" Foreground="#8B8794" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,18"/>
                                            </StackPanel>

                                            <Border Grid.Row="2" VerticalAlignment="Bottom" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock x:Name="StatL1" Text="Assertividade" FontSize="13" Foreground="#8B8794" VerticalAlignment="Center" Margin="0"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Assertiveness, Converter={StaticResource StarColorConverter}, ConverterParameter=1}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Assertiveness, Converter={StaticResource StarColorConverter}, ConverterParameter=2}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Assertiveness, Converter={StaticResource StarColorConverter}, ConverterParameter=3}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Assertiveness, Converter={StaticResource StarColorConverter}, ConverterParameter=4}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Assertiveness, Converter={StaticResource StarColorConverter}, ConverterParameter=5}" Margin="0,-2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock x:Name="StatL2" Text="Utilidade" FontSize="13" Foreground="#8B8794" VerticalAlignment="Center" Margin="0"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Usefulness, Converter={StaticResource StarColorConverter}, ConverterParameter=1}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Usefulness, Converter={StaticResource StarColorConverter}, ConverterParameter=2}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Usefulness, Converter={StaticResource StarColorConverter}, ConverterParameter=3}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Usefulness, Converter={StaticResource StarColorConverter}, ConverterParameter=4}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Usefulness, Converter={StaticResource StarColorConverter}, ConverterParameter=5}" Margin="0,-2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <TextBlock x:Name="StatL3" Text="Humanidade" FontSize="13" Foreground="#8B8794" VerticalAlignment="Center" Margin="0"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Humanity, Converter={StaticResource StarColorConverter}, ConverterParameter=1}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Humanity, Converter={StaticResource StarColorConverter}, ConverterParameter=2}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Humanity, Converter={StaticResource StarColorConverter}, ConverterParameter=3}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Humanity, Converter={StaticResource StarColorConverter}, ConverterParameter=4}" Margin="0,-2,3,0"/>
                                                            <TextBlock Text="★" FontSize="20" Foreground="{Binding Stats.Humanity, Converter={StaticResource StarColorConverter}, ConverterParameter=5}" Margin="0,-2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="DescText" Property="Foreground" Value="#CBC8D1"/>
                                                <Setter TargetName="SpeechText" Property="Foreground" Value="#CBC8D1"/>
                                                <Setter TargetName="StatL1" Property="Foreground" Value="#CBC8D1"/>
                                                <Setter TargetName="StatL2" Property="Foreground" Value="#CBC8D1"/>
                                                <Setter TargetName="StatL3" Property="Foreground" Value="#CBC8D1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>

                    <!-- Passo 3: Provedor de IA -->
                    <Grid x:Name="Step3_Provider" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                            <RowDefinition Height="Auto"/> <!-- Row 1: Provider picker -->
                            <RowDefinition Height="*"/> <!-- Row 2: Branch swap area -->
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                            <TextBlock Text="Motor de Inteligência" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="#F5F4F7" HorizontalAlignment="Center"/>
                            <TextBlock Text="Escolha o provedor que dará inteligência ao seu agente." FontSize="15" Margin="0" Foreground="#8B8794" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Provider picker -->
                        <StackPanel Grid.Row="1" Margin="20,0,20,15">
                            <RadioButton x:Name="OllamaRadio" GroupName="ProviderGroup" IsChecked="True" Margin="0,0,0,20" Checked="OllamaRadio_Checked">
                                <StackPanel Margin="10,-4,0,0">
                                    <TextBlock Text="Ollama (Local)" FontSize="16" FontWeight="SemiBold" Foreground="#F5F4F7" Margin="0,0,0,4"/>
                                    <TextBlock Text="Roda os modelos na sua própria máquina. Total privacidade, sem custos por requisição." Foreground="#8B8794" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                            
                            <RadioButton x:Name="OpenRouterRadio" GroupName="ProviderGroup" Margin="0,0,0,0" Checked="OpenRouterRadio_Checked">
                                <StackPanel Margin="10,-4,0,0">
                                    <TextBlock Text="OpenRouter (Nuvem)" FontSize="16" FontWeight="SemiBold" Foreground="#F5F4F7" Margin="0,0,0,4"/>
                                    <TextBlock Text="Acesso aos modelos de nuvem por uma API só. Requer sua chave do OpenRouter, e cada requisição é cobrada — o conteúdo da conversa sai desta máquina." Foreground="#8B8794" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Branch swap area -->
                        <Grid Grid.Row="2" Margin="20,5,20,10">
                            <!-- Ollama branch -->
                            <StackPanel x:Name="OllamaBranch" Visibility="Visible">
                                <Border Background="#06FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Modelo de Linguagem" FontWeight="SemiBold" FontSize="14" Foreground="#F5F4F7" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ModelComboBox" Height="42" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="ModelComboBox_SelectionChanged"/>
                                        <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,2,0,0"/>

                                        <StackPanel x:Name="OllamaErrorBlock" Visibility="Collapsed" Margin="0,15,0,0">
                                            <TextBlock Text="Ollama não foi detectado em localhost:11434" Foreground="#D53F8C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                            <TextBlock Text="Certifique-se de que o Ollama está rodando no seu computador." Foreground="#8B8794" FontSize="13" Margin="0,0,0,10"/>
                                            <Button x:Name="RetryButton" Content="Tentar novamente" Click="RetryButton_Click" Width="140" Height="36" HorizontalAlignment="Left" Background="#06FFFFFF" Foreground="#F5F4F7" BorderThickness="1" BorderBrush="#1AFFFFFF" Cursor="Hand" Margin="0,0,0,10"/>
                                            <TextBlock Margin="0,0,0,4" FontSize="13">
                                                <Hyperlink x:Name="FallbackLink" Foreground="#3182CE" NavigateUri="aib:fallback-model" RequestNavigate="FallbackLink_RequestNavigate">Pular e usar configuração padrão</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock x:Name="FallbackModelDisplay" Text="Modelo padrão (qwen2.5:7b) selecionado temporariamente." Visibility="Collapsed" Foreground="#3182CE" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Ramo do OpenRouter -->
                            <StackPanel x:Name="OpenRouterBranch" Visibility="Collapsed">
                                <Border Background="#06FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Sua Chave do OpenRouter" FontWeight="SemiBold" FontSize="14" Foreground="#F5F4F7" Margin="0,0,0,8"/>
                                        <PasswordBox x:Name="KeyTextBox" Height="42" FontSize="14" VerticalContentAlignment="Center" LostFocus="KeyTextBox_LostFocus" KeyDown="KeyTextBox_KeyDown" PasswordChanged="KeyTextBox_PasswordChanged"/>
                                        <TextBlock Text="* Sua chave será protegida com criptografia DPAPI no cofre do Windows." Margin="0,8,0,0" Foreground="#8B8794" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ErrorLabel" Text="Formato de chave inválido (deve começar com sk-or-)" Foreground="#D53F8C" FontWeight="SemiBold" FontSize="13" Visibility="Collapsed" Margin="0,10,0,0"/>
                                        <TextBlock Text="Modelo" FontWeight="SemiBold" FontSize="14" Foreground="#F5F4F7" Margin="0,18,0,8"/>
                                        <ComboBox x:Name="OpenRouterModelComboBox" Height="42" FontSize="14" IsEditable="True" VerticalContentAlignment="Center" SelectionChanged="ModelComboBox_SelectionChanged" LostFocus="OpenRouterModel_LostFocus"/>
                                        <TextBlock x:Name="OpenRouterModelInfo" Text="Carregando o catálogo do OpenRouter… só aparecem modelos que aceitam ferramentas." Margin="0,8,0,0" Foreground="#8B8794" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Passo 4: Sistema de Níveis -->
                    <Grid x:Name="Step4_Levels" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="550">
                            <TextBlock Text="Níveis de Autonomia" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="#F5F4F7" HorizontalAlignment="Center"/>
                            <TextBlock Text="A inteligência artificial opera através de diferentes níveis de permissão. Isso garante a sua segurança enquanto você se acostuma com as capacidades do agente." FontSize="15" Foreground="#8B8794" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                            
                            <Border Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🟢" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nível 1: Assistente Passivo" FontWeight="SemiBold" FontSize="15" Foreground="#F5F4F7" Margin="0,0,0,4"/>
                                        <TextBlock Text="A IA apenas lê arquivos e sugere ações. Nenhuma modificação é feita sem a sua autorização expressa em cada passo." Foreground="#8B8794" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🟡" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nível 2: Operador Guiado" FontWeight="SemiBold" FontSize="15" Foreground="#F5F4F7" Margin="0,0,0,4"/>
                                        <TextBlock Text="Pode criar e modificar arquivos de projeto, mas exige confirmação antes de rodar comandos no terminal ou apagar dados." Foreground="#8B8794" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔴" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nível 3: Autonomia Total" FontWeight="SemiBold" FontSize="15" Foreground="#F5F4F7" Margin="0,0,0,4"/>
                                        <TextBlock Text="A IA atua sozinha para resolver problemas, executando comandos complexos no sistema operacional de forma independente." Foreground="#8B8794" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Passo 5: Níveis de Usuário -->
                    <Grid x:Name="Step5_UserLevels" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="550">
                            <TextBlock Text="Seu Crescimento" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="#F5F4F7" HorizontalAlignment="Center"/>
                            <TextBlock Text="O sistema possui uma progressão de níveis. À medida que você utiliza a IA, você ganha experiência e evolui do Nível 1 ao Nível 9." FontSize="15" Foreground="#8B8794" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="🥉 Níveis 1 a 3" FontWeight="Bold" FontSize="14" Foreground="#F5F4F7" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Iniciante" FontWeight="SemiBold" FontSize="13" Foreground="#E28743" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Foco em aprendizado e tarefas guiadas." Foreground="#8B8794" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="🥈 Níveis 4 a 6" FontWeight="Bold" FontSize="14" Foreground="#F5F4F7" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Intermediário" FontWeight="SemiBold" FontSize="13" Foreground="#A0AEC0" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Maior autonomia, criação de scripts." Foreground="#8B8794" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#06FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="🥇 Níveis 7 a 9" FontWeight="Bold" FontSize="14" Foreground="#F5F4F7" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Avançado" FontWeight="SemiBold" FontSize="13" Foreground="#ECC94B" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Domínio total sem supervisão." Foreground="#8B8794" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <TextBlock Text="Ao subir de nível, você destrava customizações visuais, permissões avançadas e mais flexibilidade no sistema de autonomia." FontSize="13" Foreground="#E28743" TextWrapping="Wrap" TextAlignment="Center" Margin="0,30,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer buttons (HTML CSS match) -->
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="CancelButton" Grid.Column="0" Content="Sair" Click="Cancel_Click" IsCancel="True"
                                        Width="60" Height="40" FontSize="14" FontWeight="SemiBold"
                                        Background="Transparent" Foreground="#A8A4B0" BorderThickness="0" Cursor="Hand"/>
                                        
                                <Button x:Name="BackButton" Grid.Column="2" Content="Voltar" Click="Back_Click" Visibility="Collapsed"
                                        Width="90" Height="40" FontSize="14" FontWeight="SemiBold"
                                        Background="Transparent" Foreground="#E8E6EC" BorderThickness="1" BorderBrush="#2EFFFFFF" Cursor="Hand" Margin="0,0,12,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                        
                                <Button x:Name="NextButton" Grid.Column="3" Content="Próximo" Click="Next_Click" IsDefault="True"
                                        Width="110" Height="40" FontSize="14" FontWeight="Bold" Foreground="White" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource AiAccent}" CornerRadius="10">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#9B51E0" Opacity="0.35"/>
                                                </Border.Effect>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
