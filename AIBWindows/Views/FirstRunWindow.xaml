<Window x:Class="AIB.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao AIB"
        Width="650"
        SizeToContent="Height"
        MinHeight="550"
        MaxHeight="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutBg" Color="#EE121214" />
        <SolidColorBrush x:Key="SystemBorder" Color="#3FFFFFFF" />
        <SolidColorBrush x:Key="SystemText" Color="#F2F2F5" />
        <SolidColorBrush x:Key="InputBg" Color="#15FFFFFF" />

        <LinearGradientBrush x:Key="AiAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B5BFF" Offset="0"/>
            <GradientStop Color="#6A3BFF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SystemText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- Sombra de flutuação -->
    <Window.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                          Color="#000000" Opacity="0.55"/>
    </Window.Effect>

    <!-- Container principal com bordas arredondadas e gradiente -->
    <Border CornerRadius="16" Padding="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9B51E0" Offset="0"/>
                <GradientStop Color="#3182CE" Offset="0.33"/>
                <GradientStop Color="#D53F8C" Offset="0.66"/>
                <GradientStop Color="#E28743" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- Fundo Escuro Interno -->
        <Border CornerRadius="14" Background="#F01A1A1E">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>    <!-- Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Footer buttons -->
                </Grid.RowDefinitions>

                <!-- Passo 1: Boas Vindas -->
                <Grid x:Name="Step1_Welcome" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Boas-vindas" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" Foreground="White" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="Este é o seu novo assistente virtual inteligente." FontSize="16" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Ele é capaz de ler e modificar documentos, executar comandos no seu terminal, e automatizar tarefas do seu dia a dia diretamente no seu computador." 
                                   FontSize="14" Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30" MaxWidth="500"/>
                                   
                        <Border Background="#2A1B15" BorderBrush="#D27519" BorderThickness="1" CornerRadius="8" Padding="15" MaxWidth="450" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Esta ferramenta está em fase Beta. Ela tem autonomia para executar ações na sua máquina, portanto revise cuidadosamente os planos antes de aprovar comandos sensíveis." 
                                           FontSize="13" Foreground="#E28743" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Passo 2: Perfil da IA -->
                <Grid x:Name="Step2_Profile" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="Quem sou eu" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="White" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="Nome da Inteligência Artificial" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBox x:Name="AiNameTextBox" Height="40" FontSize="14" VerticalContentAlignment="Center" Text="Assistente" Padding="10,0"/>
                        
                        <TextBlock Text="Descreva minha persona" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,8"/>
                        <TextBlock Text="Defina como ela deve pensar, falar e agir (ex: 'seja direto e formal' ou 'fale como um pirata')." Opacity="0.6" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="AiPersonaTextBox" Height="100" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" VerticalScrollBarVisibility="Auto" Text="Você é um assistente de produtividade prestativo e profissional."/>
                    </StackPanel>
                </Grid>

                <!-- Passo 3: Provedor de IA -->
                <Grid x:Name="Step3_Provider" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Provider picker -->
                        <RowDefinition Height="*"/> <!-- Row 2: Branch swap area -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock Text="Motor de Inteligência" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Escolha o provedor que dará inteligência ao seu agente." FontSize="15" Margin="0,0,0,0" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Provider picker -->
                    <StackPanel Grid.Row="1" Margin="20,0,20,15">
                        <RadioButton x:Name="OllamaRadio"
                                     GroupName="ProviderGroup"
                                     IsChecked="True"
                                     Margin="0,0,0,20"
                                     Checked="OllamaRadio_Checked">
                            <StackPanel Margin="10,-4,0,0">
                                <TextBlock Text="Ollama (Local)" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Roda os modelos na sua própria máquina. Total privacidade, sem custos por requisição." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <RadioButton x:Name="OpenAiRadio"
                                     GroupName="ProviderGroup"
                                     Margin="0,0,0,0"
                                     Checked="OpenAiRadio_Checked">
                            <StackPanel Margin="10,-4,0,0">
                                <TextBlock Text="OpenAI (Nuvem)" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Conecta aos servidores da OpenAI para modelos de ponta. Requer sua chave de API." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Branch swap area -->
                    <Grid Grid.Row="2" Margin="20,5,20,10">
                        <!-- Ollama branch -->
                        <StackPanel x:Name="OllamaBranch" Visibility="Visible">
                            <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="20" BorderBrush="#1A1A20" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Modelo de Linguagem" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ModelComboBox"
                                              Height="42" FontSize="14"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.Name="Modelo instalado no Ollama"
                                              SelectionChanged="ModelComboBox_SelectionChanged"/>
                                    <ProgressBar x:Name="LoadingProgress"
                                                 IsIndeterminate="True"
                                                 Height="2"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,2,0,0"/>

                                    <StackPanel x:Name="OllamaErrorBlock" Visibility="Collapsed" Margin="0,15,0,0">
                                        <TextBlock Text="Ollama não foi detectado em localhost:11434"
                                                   Foreground="#D53F8C" FontWeight="SemiBold"
                                                   FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock Text="Certifique-se de que o Ollama está rodando no seu computador."
                                                   Opacity="0.7" FontSize="13" Margin="0,0,0,10"/>
                                        <Button x:Name="RetryButton"
                                                Content="Tentar novamente"
                                                Click="RetryButton_Click"
                                                Width="140" Height="36"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource InputBg}"
                                                Foreground="White" BorderBrush="#2A2A30" Cursor="Hand" Margin="0,0,0,10"/>
                                        <TextBlock Margin="0,0,0,4" FontSize="13">
                                            <Hyperlink x:Name="FallbackLink" Foreground="#3182CE" RequestNavigate="FallbackLink_RequestNavigate">Pular e usar configuração padrão</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock x:Name="FallbackModelDisplay"
                                               Text="Modelo padrão (qwen2.5:7b) selecionado temporariamente."
                                               Visibility="Collapsed" Opacity="0.8"
                                               Foreground="#3182CE" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- OpenAI branch -->
                        <StackPanel x:Name="OpenAiBranch" Visibility="Collapsed">
                            <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="20" BorderBrush="#1A1A20" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Sua Chave da API" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBox x:Name="KeyTextBox" Height="42" FontSize="14" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Chave da API da OpenAI"
                                             LostFocus="KeyTextBox_LostFocus" KeyDown="KeyTextBox_KeyDown"/>
                                    <TextBlock Text="* Sua chave será protegida com criptografia DPAPI no cofre do Windows."
                                               Margin="0,8,0,0" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ErrorLabel" Text="Formato de chave inválido (deve começar com sk-)"
                                               Foreground="#D53F8C" FontWeight="SemiBold" FontSize="13"
                                               Visibility="Collapsed" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Passo 4: Sistema de Níveis -->
                <Grid x:Name="Step4_Levels" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" MaxWidth="550">
                        <TextBlock Text="Níveis de Autonomia" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="A inteligência artificial opera através de diferentes níveis de permissão. Isso garante a sua segurança enquanto você se acostuma com as capacidades do agente." 
                                   FontSize="15" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                        
                        <Border Background="#1A1A20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🟢" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nível 1: Assistente Passivo" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="A IA apenas lê arquivos e sugere ações. Nenhuma modificação é feita sem a sua autorização expressa em cada passo." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1A1A20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🟡" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nível 2: Operador Guiado" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Pode criar e modificar arquivos de projeto, mas exige confirmação antes de rodar comandos no terminal ou apagar dados." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1A1A20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔴" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nível 3: Autonomia Total" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="A IA atua sozinha para resolver problemas, executando comandos complexos no sistema operacional de forma independente." Opacity="0.6" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Sair" Click="Cancel_Click" IsCancel="True"
                            Width="90" Height="40" FontSize="14"
                            Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                            
                    <Button x:Name="BackButton" Content="Voltar" Click="Back_Click" Visibility="Collapsed"
                            Width="100" Height="40" FontSize="14"
                            Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="#3FFFFFFF" Cursor="Hand" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                            
                    <Button x:Name="NextButton" Content="Próximo" Click="Next_Click" IsDefault="True"
                            Width="120" Height="40" FontSize="14" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AiAccent}" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
