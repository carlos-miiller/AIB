<Window x:Class="AIB.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AIB.Ui"
        Title="Configurações AIB"
        Width="700" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        Implementação de refactor-interface/tela-configuracoes.html.
        A janela do WPF é maior que os 620x560 do desenho porque a DropShadow
        precisa de área para desenhar e não pode ser recortada (§3.1). A margem
        do Border faz a conta: 700-40-40 = 620 e 650-30-60 = 560.
    -->
    <Border Margin="40,30,40,60"
            Background="{StaticResource NeonBrush}"
            CornerRadius="{StaticResource RadiusWindowOuter}"
            Padding="1.5"
            Effect="{StaticResource WindowShadow}">

        <Border Background="{StaticResource GlassBrush}"
                CornerRadius="{StaticResource RadiusWindowInner}"
                ClipToBounds="True">

            <!-- O `*` na linha do meio é o que impede o rodapé de sair da tela. A7. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     §3.3  CABEÇALHO
                     ══════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- O glyph acompanha a primeira linha do título, não o centro do bloco. -->
                    <TextBlock Grid.Column="0" Text="✦" FontSize="15"
                               Foreground="{StaticResource AccentLilacBrush}"
                               VerticalAlignment="Top" Margin="24,20,10,0" LineHeight="22"/>

                    <StackPanel Grid.Column="1" Margin="0,20,0,16">
                        <TextBlock Text="Configurações"
                                   FontSize="{StaticResource FontSizeHeaderTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextStrongBrush}"/>
                        <!-- TEXTO VERBATIM — §3.3. -->
                        <TextBlock Text="Personalize a identidade, conexão e comportamento do AIB."
                                   FontSize="{StaticResource FontSizeHeaderSub}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource CloseIconButton}"
                            VerticalAlignment="Top" Margin="0,16,16,0"
                            Click="Cancel_Click" ToolTip="Fechar">
                        <Path Data="M4,4 L12,12 M12,4 L4,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="None"/>
                    </Button>

                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1"
                               Fill="{StaticResource DividerBrush}"/>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════
                     §3.4/§3.5  SEÇÕES — única área elástica
                     ══════════════════════════════════════════════════════════ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20,24,22">
                    <StackPanel>

                        <!-- ─────────────── SEÇÃO 1 — Identidade (Soul) ─────────────── -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IDENTIDADE (SOUL)" Style="{StaticResource SectionHeadText}"
                                       ui:LetterSpacing.Em="0.10"/>
                            <Rectangle Grid.Column="1" Height="1" Margin="10,0,0,0"
                                       Fill="{StaticResource DividerBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCardLarge}" Padding="16,4">
                            <StackPanel>
                                <!-- CAMPO 1 — último do card: sem divisória. -->
                                <Grid Margin="0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Personagem Ativo" Style="{StaticResource FieldLabelText}"/>
                                        <TextBlock Text="A Inteligência escolhida na tela de seleção."
                                                   Style="{StaticResource FieldHelpText}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CharacterComboBox" Grid.Column="1"
                                              Style="{StaticResource ControlComboBox}"
                                              SelectionChanged="Campo_Mudou"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────── SEÇÃO 2 — Conexão LLM ─────────────── -->
                        <Grid Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONEXÃO LLM" Style="{StaticResource SectionHeadText}"
                                       ui:LetterSpacing.Em="0.10"/>
                            <Rectangle Grid.Column="1" Height="1" Margin="10,0,0,0"
                                       Fill="{StaticResource DividerBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCardLarge}" Padding="16,4">
                            <StackPanel>

                                <!-- CAMPO 2 — Provedor de IA -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Provedor de IA" Style="{StaticResource FieldLabelText}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="ProviderComboBox" Grid.Column="1"
                                                  Style="{StaticResource ControlComboBox}"
                                                  SelectionChanged="ProviderComboBox_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 3 — Base URL -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabelText}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <TextBox x:Name="UrlTextBox" Grid.Column="1"
                                                 Style="{StaticResource ControlTextBoxMono}"
                                                 TextChanged="Campo_Mudou"
                                                 LostFocus="UrlTextBox_LostFocus"/>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 4 — API Key. Somente leitura: a escrita é do fluxo
                                     "Alterar", que não exibe a chave atual (§5 campo 4). -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="API Key" Style="{StaticResource FieldLabelText}"/>
                                            <!-- Linha de ajuda, não placeholder: placeholder some
                                                 ao digitar e leva a informação junto. A6. -->
                                            <TextBlock Text="Não necessário para Ollama."
                                                       Style="{StaticResource FieldHelpText}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="KeyTextBox"
                                                     Style="{StaticResource ControlTextBoxMono}"
                                                     IsReadOnly="True" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Alterar"
                                                    Style="{StaticResource InlineButton}"
                                                    Click="AlterarChave_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 5 — Modelo LLM (Principal). Último: sem divisória. -->
                                <Grid Margin="0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Modelo LLM (Principal)" Style="{StaticResource FieldLabelText}"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Grid Grid.Column="1">
                                        <ComboBox x:Name="ModelComboBox" IsEditable="True"
                                                  Style="{StaticResource ControlComboBoxMono}"
                                                  SelectionChanged="Campo_Mudou"/>
                                        <!-- Aviso de carga da lista de modelos. Não é campo:
                                             mora sobre o controle e some sozinho. -->
                                        <TextBlock x:Name="LoadingProgress" Text="carregando…"
                                                   FontSize="{StaticResource FontSizeHelp}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,34,0" Visibility="Collapsed"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────── SEÇÃO 3 — Avançado ─────────────── -->
                        <Grid Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AVANÇADO" Style="{StaticResource SectionHeadText}"
                                       ui:LetterSpacing.Em="0.10"/>
                            <Rectangle Grid.Column="1" Height="1" Margin="10,0,0,0"
                                       Fill="{StaticResource DividerBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCardLarge}" Padding="16,4">
                            <StackPanel>

                                <!-- CAMPO 6 — Máximo de Tokens de Contexto. SOMENTE LEITURA:
                                     vem do nível do usuário, não é preferência. -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Máximo de Tokens de Contexto" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="Definido pelo modelo carregado."
                                                       Style="{StaticResource FieldHelpText}"/>
                                        </StackPanel>
                                        <TextBox x:Name="MaxHistoryTextBox" Grid.Column="1"
                                                 Style="{StaticResource ControlTextBoxMono}"
                                                 IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 7 — Keep-Alive -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tempo de Memória da IA (Keep-Alive)"
                                                   Style="{StaticResource FieldLabelText}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="KeepAliveComboBox" Grid.Column="1"
                                                  Style="{StaticResource ControlComboBox}"
                                                  SelectionChanged="Campo_Mudou">
                                            <ComboBoxItem Content="1 Minuto" Tag="1m"/>
                                            <ComboBoxItem Content="5 Minutos (Recomendado)" Tag="5m"/>
                                            <ComboBoxItem Content="30 Minutos" Tag="30m"/>
                                            <ComboBoxItem Content="Sempre carregado" Tag="-1"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 8 — Enviar System Prompt a cada requisição -->
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerFieldBrush}">
                                    <Grid Margin="0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Enviar System Prompt a cada requisição"
                                                       Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="KV Caching." Style="{StaticResource FieldHelpText}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="SendSystemPromptSwitch" Grid.Column="1"
                                                      Style="{StaticResource Switch}"
                                                      Checked="Campo_Mudou" Unchecked="Campo_Mudou"/>
                                    </Grid>
                                </Border>

                                <!-- CAMPO 9 — Logs detalhados. Último: sem divisória. -->
                                <Grid Margin="0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource ControlColumnGrid}"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Logs detalhados no console"
                                                   Style="{StaticResource FieldLabelText}"/>
                                        <TextBlock Style="{StaticResource FieldHelpText}">
                                            <Run Text="Modo "/><Hyperlink x:Name="DebugLink"
                                                       Foreground="{StaticResource AccentLilacBrush}"
                                                       TextDecorations="{x:Null}"
                                                       Click="DebugLink_Click"><Run Text="debug"/></Hyperlink><Run Text="."/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ToggleButton x:Name="VerboseLoggingSwitch" Grid.Column="1"
                                                  Style="{StaticResource Switch}"
                                                  Checked="Campo_Mudou" Unchecked="Campo_Mudou"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     §3.9  RODAPÉ
                     ══════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}"/>

                    <Grid Grid.Row="1" Margin="24,14,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Reset de Fábrica"
                                Style="{StaticResource DangerOutlineButton}"
                                Click="WipeData_Click"/>

                        <Button Grid.Column="2" Content="Cancelar"
                                Style="{StaticResource OutlineButton}"
                                Click="Cancel_Click" Margin="0,0,10,0"/>

                        <!-- Nasce desabilitado. Sem isso o usuário não sabe se mexeu
                             em algo. O7 / A8. -->
                        <Button x:Name="SaveButton" Grid.Column="3" Content="Salvar"
                                Style="{StaticResource PrimaryButton}"
                                Click="Save_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
