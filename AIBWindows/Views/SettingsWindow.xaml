<Window x:Class="AIB.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações AIB" 
        Height="700" Width="450"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1A1E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A1E" />
        
        <SolidColorBrush x:Key="SystemText" Color="#E0E0E0" />
        <SolidColorBrush x:Key="InputBg" Color="#1A1A1E" />
        
        <LinearGradientBrush x:Key="AiAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B51E0" Offset="0"/>
            <GradientStop Color="#3182CE" Offset="0.33"/>
            <GradientStop Color="#D53F8C" Offset="0.66"/>
            <GradientStop Color="#E28743" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SystemText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <Path x:Name="Arrow" Fill="#E8E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="10,0,30,0"
                                     Focusable="True" 
                                     Background="Transparent"
                                     Foreground="#E8E8F0"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A1A1E" BorderThickness="0" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsHitTestVisible" TargetName="ContentSite" Value="false"/>
                                <Setter Property="Visibility" TargetName="PART_EditableTextBox" Value="Visible"/>
                                <Setter Property="Visibility" TargetName="ContentSite" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1A1A1E"/>
                        <Setter Property="Foreground" Value="#E8E8F0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#309B51E0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#509B51E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                          Color="#000000" Opacity="0.55"/>
    </Window.Effect>

    <!-- Main Capsule Container -->
    <Border CornerRadius="24" Padding="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9B51E0" Offset="0"/>
                <GradientStop Color="#3182CE" Offset="0.33"/>
                <GradientStop Color="#D53F8C" Offset="0.66"/>
                <GradientStop Color="#E28743" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border CornerRadius="22" Background="#F0101013" ClipToBounds="True">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock Text="✦" FontSize="16" Foreground="#9B51E0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CONFIGURAÇÕES" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="Personalize a identidade, conexão e comportamento do AIB." Margin="0,0,0,10" Opacity="0.6"/>
                    <Border Height="1" Background="#15FFFFFF" Margin="0,0,0,10"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                        
                        <!-- PERSONA -->
                        <TextBlock Text="IDENTIDADE (SOUL)" FontWeight="Bold" Foreground="#3182CE" Margin="0,5,0,5"/>
                        <TextBlock Text="Personagem Ativo"/>
                        <Border Background="{StaticResource InputBg}" CornerRadius="12">
                            <ComboBox x:Name="CharacterComboBox" Height="38" Background="Transparent" BorderThickness="0" Foreground="White"/>
                        </Border>

                        <Separator Background="White" Opacity="0.05" Margin="0,20,0,10"/>
                        
                        <!-- CONNECTION -->
                        <TextBlock Text="CONEXÃO LLM" FontWeight="Bold" Foreground="#D53F8C" Margin="0,5,0,5"/>
                        
                        <TextBlock Text="Provedor de IA"/>
                        <Border Background="{StaticResource InputBg}" CornerRadius="12">
                            <ComboBox x:Name="ProviderComboBox" Height="38" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ProviderComboBox_SelectionChanged">
                                <ComboBoxItem Content="Ollama"/>
                                <ComboBoxItem Content="OpenAI"/>
                                <ComboBoxItem Content="Google Gemini"/>
                            </ComboBox>
                        </Border>

                        <StackPanel x:Name="AdvancedConnectionPanel">
                            <TextBlock Text="Base URL"/>
                            <TextBox x:Name="UrlTextBox" Text="http://127.0.0.1:11434/v1" LostFocus="UrlTextBox_LostFocus"/>

                            <TextBlock Text="API Key"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KeyTextBox" Grid.Column="0" IsReadOnly="True" Foreground="#888888"/>
                                <Button x:Name="AlterarChaveButton" Grid.Column="1" Content="Alterar" Width="80" Height="35" Margin="5,0,0,0" Click="AlterarChave_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#2AFFFFFF" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <TextBlock Text="Modelo LLM (Principal)"/>
                            <Grid>
                                <Border Background="{StaticResource InputBg}" CornerRadius="12">
                                    <ComboBox x:Name="ModelComboBox" IsEditable="True" Height="38" Background="Transparent" BorderThickness="0" Foreground="White"/>
                                </Border>
                                <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed" Margin="10,0"/>
                            </Grid>
                        </StackPanel>

                        <Separator Background="White" Opacity="0.05" Margin="0,20,0,10"/>
                        
                        <!-- ADVANCED -->
                        <TextBlock Text="AVANÇADO" FontWeight="Bold" Foreground="#E28743" Margin="0,5,0,5"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Máximo de Tokens de Contexto" Grid.Column="0" VerticalAlignment="Center" Margin="0"/>
                            <TextBox x:Name="MaxHistoryTextBox" Grid.Column="1" Width="80" TextAlignment="Center" IsReadOnly="True" Foreground="#888899"/>
                        </Grid>

                        <TextBlock Text="Tempo de Memória da IA (Keep-Alive)"/>
                        <Border Background="{StaticResource InputBg}" CornerRadius="12">
                            <ComboBox x:Name="KeepAliveComboBox" Height="38" Background="Transparent" BorderThickness="0" Foreground="White">
                                <ComboBoxItem Content="Infinito (Alta Performance)" Tag="-1"/>
                                <ComboBoxItem Content="30 Minutos" Tag="30m"/>
                                <ComboBoxItem Content="10 Minutos" Tag="10m"/>
                                <ComboBoxItem Content="5 Minutos (Recomendado)" Tag="5m"/>
                                <ComboBoxItem Content="3 Minutos" Tag="3m"/>
                                <ComboBoxItem Content="0 Minutos (Esvaziar Imediatamente)" Tag="0"/>
                            </ComboBox>
                        </Border>

                        <CheckBox x:Name="SendSystemPromptCheckBox" Content="Enviar System Prompt a cada requisição (KV Caching)" Foreground="White" Margin="0,15,0,0"/>
                        <CheckBox x:Name="VerboseLoggingCheckBox" Foreground="White" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,0">
                                <Run Text="Logs detalhados no console "/>
                                <Run Text="(debug)" Foreground="#3182CE" FontWeight="Bold"/>
                            </TextBlock>
                        </CheckBox>
                        
                        <TextBlock Height="20"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- BUTTONS -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Button Content="Reset de Fábrica" Click="WipeData_Click" Width="120" Height="35" Foreground="#FF4444" Cursor="Hand" HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1A1A1E" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="Cancel_Click" Width="80" Height="35" Foreground="White" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Salvar" Click="Save_Click" Width="100" Height="35" Foreground="White" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource AiAccent}" CornerRadius="18">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
