<Window x:Class="AIB.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- §5.3 do tela-chat-v3: a casca é a MESMA da bolha da IA, com borda NEUTRA.
         O alerta vem do conteúdo, não da borda — colorir a moldura de vermelho
         faria o card gritar antes de o usuário ler o que ele diz.
         Aqui vive como janela porque as Configurações precisam de um diálogo
         modal; no chat a mesma anatomia entra como card na coluna da IA. -->
    <Border Margin="30,20,30,45" Background="{StaticResource NeonBrush}"
            CornerRadius="{StaticResource RadiusWindowOuter}" Padding="1.5"
            Effect="{StaticResource WindowShadow}">
        <Border Background="{StaticResource GlassBrush}"
                CornerRadius="{StaticResource RadiusWindowInner}" ClipToBounds="True">
            <StackPanel Margin="16,15,16,14">

                <!-- (a) PILL — diz o que importa da ação ("Não há desfazer", "Volta com mensagem
                     nova"); vermelha ou laranja conforme tenha volta. Pintada em código. -->
                <Border x:Name="Pill" Style="{StaticResource PillBorder}"
                        Background="{StaticResource DangerFill14Brush}"
                        BorderBrush="{StaticResource DangerEdge32Brush}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="PillIcone" Data="M6,1 L11.5,10.5 L0.5,10.5 Z M6,4.6 L6,7.4 M6,8.8 L6,9.2"
                              Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="11" Stretch="None"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PillTexto" Text="Não há desfazer" Style="{StaticResource PillText}"
                                   Foreground="{StaticResource DangerTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- (b) TÍTULO em forma de PERGUNTA. -->
                <TextBlock x:Name="TituloText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextStrongBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <!-- (c) SUBTÍTULO com a consequência real. -->
                <TextBlock x:Name="ConsequenciaText" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"/>

                <!-- (d) CAIXA DO ALVO — recolhida quando a ação não tem alvo literal. -->
                <Border x:Name="AlvoBox" Background="{StaticResource SurfaceCodeBrush}"
                        CornerRadius="{StaticResource RadiusCard}" Padding="12,10"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AlvoFerramentaText" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="AlvoCaminhoText" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12" Foreground="{StaticResource TextBodyBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- (e) A PALAVRA, só no reset de fábrica: o botão acende com ela completa. -->
                <StackPanel x:Name="PalavraBox" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="PalavraRotulo" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBodyBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PalavraTexto" Style="{StaticResource ControlTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             TextChanged="Palavra_TextChanged"/>
                </StackPanel>

                <!-- (f) RODAPÉ separado por divisória. -->
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16,0,0"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PermitirButton" Grid.Column="0" Content="Confirmar"
                            Style="{StaticResource DangerFilledButton}"
                            Click="Permitir_Click" Margin="0,0,10,0"/>
                    <Button x:Name="RecusarButton" Grid.Column="1" Content="Cancelar"
                            Style="{StaticResource OutlineButton}" Padding="18,8"
                            Click="Recusar_Click" IsCancel="True"/>
                    <TextBlock x:Name="DicaText" Grid.Column="2" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
