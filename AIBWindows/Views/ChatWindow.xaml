<Window x:Class="AIB.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIB.Views"
        Title="AIB"
        Width="820"
        Height="605"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        Implementação de refactor-interface/tela-chat-v3.html.

        A janela do WPF é maior que os 770x520 do desenho porque a DropShadow
        precisa de área para desenhar e não pode ser recortada (§3.1). A margem
        do MainRootBorder faz a conta: 40+770+10 = 820 e 25+520+60 = 605.

        Largura FIXA: quando o painel lateral abre, a janela de chat NÃO encolhe;
        o painel aparece ao lado. A2.
    -->
    <Window.Resources>

        <!-- §3.5 — BOLHAS. Raio 18 UNIFORME nas duas: a geometria é de card,
             herdada da tela de seleção. Não voltar ao canto "rabinho". O4. -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusBubble}"/>
            <Setter Property="Padding" Value="17,13"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <!-- SEM sombra e SEM glow. Só o degradê. O5. -->
        </Style>

        <Style x:Key="AgentBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusBubble}"/>
            <Setter Property="Padding" Value="17,13"/>
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- §3.9 — HORA. Fora da bolha, some por padrão e aparece no hover da
             linha. Dentro da linha ela ocuparia espaço e empurraria a bolha
             para longe da borda. A5. -->
        <Style x:Key="StampText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeStamp}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Padding" Value="4,0,4,3"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- §3.7(e) — BOTÃO PRIMÁRIO do input: 38px circular, gradiente primary
             com glow. Sempre ENVIAR; o microfone é botão separado. O10 / A7. -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Width" Value="{StaticResource RecordButtonSize}"/>
            <Setter Property="Height" Value="{StaticResource RecordButtonSize}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="19" Effect="{StaticResource SendGlow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">

        <!-- ══════════════════════════════════════════════════════════════
             JANELA DE CHAT  770 x 520
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="MainRootBorder"
                Width="770" Height="520"
                Margin="40,25,10,60"
                VerticalAlignment="Bottom"
                Background="{StaticResource NeonBrush}"
                CornerRadius="{StaticResource RadiusWindowOuter}"
                Padding="1.5"
                Effect="{StaticResource WindowShadow}">

            <Border Background="{StaticResource GlassBrush}"
                    CornerRadius="{StaticResource RadiusWindowInner}"
                    ClipToBounds="True">

                <!-- Row 1 = "*" é o que impede a lista de crescer com o conteúdo e
                     empurrar o input e o rodapé para fora do frame. A3. -->
                <Grid x:Name="MainAreaGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── §3.3  HEADER  52px ───────────────────────────── -->
                    <Grid Grid.Row="0" Height="{StaticResource HeaderHeight}"
                          Background="Transparent"
                          MouseDown="Window_MouseDown" Cursor="SizeAll">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="✦" FontSize="13" LineHeight="13"
                                       Foreground="{StaticResource AccentLilacBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <TextBlock x:Name="AgentNameText" Text="AIB"
                                       FontSize="{StaticResource FontSizeAgentName}"
                                       FontWeight="SemiBold" LineHeight="16"
                                       Foreground="{StaticResource TextStrongBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- PILL de nível: a mesma da tela de seleção. A cor é
                                 sempre lilás — a faixa (bronze…diamante) vive na
                                 barra de XP do ToolTip, para a moldura neon seguir
                                 sendo a única cor saturada. O2. -->
                            <Border Style="{StaticResource PillBorder}" Margin="10,0,0,0">
                                <TextBlock x:Name="LevelText" Text="Nível 1"
                                           Style="{StaticResource PillText}"/>
                                <Border.ToolTip>
                                    <ToolTip Background="{StaticResource SurfaceTooltipBrush}"
                                             BorderBrush="{StaticResource AccentBorderBrush}"
                                             BorderThickness="1" HasDropShadow="True">
                                        <StackPanel Margin="6">
                                            <TextBlock x:Name="TooltipLevelInfo" Text="Nível 1 (0/20 XP)"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextBodyBrush}"/>
                                            <ProgressBar x:Name="XpProgressBar" Width="180" Height="6"
                                                         Margin="0,6,0,0" Value="0" Maximum="20"
                                                         Background="{StaticResource SurfaceCodeBrush}"
                                                         BorderThickness="0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>

                        <!-- 4 botões de 34px. §3.3(e). -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,12,0">

                            <!-- Shadow Assistant fica OCULTO: não consta em nenhuma das
                                 duas specs. Implementação futura — não remover o botão
                                 nem os handlers, só não exibir. -->
                            <Button x:Name="BtnToggleShadow" Style="{StaticResource IconButton}"
                                    Click="BtnToggleShadow_Click" Visibility="Collapsed"
                                    ToolTip="Shadow Assistant (Alpha)"/>

                            <Button x:Name="SidebarButton" Style="{StaticResource IconButton}"
                                    Click="SidebarButton_Click" ToolTip="Painel lateral">
                                <Path Data="M2.5,3.5 H15.5 V14.5 H2.5 Z M11,3.5 V14.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" Width="18" Height="18" Stretch="None"/>
                            </Button>

                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                    Click="SettingsButton_Click" ToolTip="Configurações">
                                <!-- Engrenagem em duas partes: aro fino e DENTES curtos e
                                     grossos. Com traço único e fino os oito raios saem longos
                                     e o ícone lê como um sol, não como uma engrenagem. -->
                                <Grid Width="18" Height="18">
                                    <Path Data="M9,5.6 A3.4,3.4 0 1 1 9,12.4 A3.4,3.4 0 1 1 9,5.6 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" Stretch="None"/>
                                    <Path Data="M9,1.6 V3.2 M9,14.8 V16.4 M16.4,9 H14.8 M3.2,9 H1.6 M14.2,3.8 L13.1,4.9 M4.9,13.1 L3.8,14.2 M14.2,14.2 L13.1,13.1 M4.9,4.9 L3.8,3.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                          Stretch="None"/>
                                </Grid>
                            </Button>

                            <Button x:Name="ClearButton" Style="{StaticResource IconButton}"
                                    Click="ClearButton_Click" ToolTip="Limpar conversa">
                                <Path Data="M3,4.8 H15 M7,4.8 V3.2 H11 V4.8 M4.8,4.8 V15 H13.2 V4.8 M7.6,7.4 V12.4 M10.4,7.4 V12.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="None"/>
                            </Button>

                            <Button Style="{StaticResource CloseIconButton}"
                                    Click="CloseButton_Click" ToolTip="Fechar">
                                <Path Data="M5,5 L13,13 M13,5 L5,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="None"/>
                            </Button>
                        </StackPanel>

                        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                                   Fill="{StaticResource DividerBrush}"/>
                    </Grid>

                    <!-- ── §3.4  LISTA DE MENSAGENS ─────────────────────── -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="26,24" Background="Transparent">
                            <StackPanel x:Name="MessagesPanel" VerticalAlignment="Top"/>
                        </ScrollViewer>

                        <!-- §5.6  CONVERSA VAZIA. Ocupa a lista inteira; sem botões,
                             o convite é o input. -->
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="46" Height="46" CornerRadius="23"
                                    Background="{StaticResource AccentFill12Brush}"
                                    BorderBrush="{StaticResource AccentEdge28Brush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="✦" FontSize="18"
                                           Foreground="{StaticResource AccentLilacBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitleText" Text="Nenhuma conversa ainda"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextStrongBrush}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="Peça alguma coisa e o trabalho começa aqui."
                                       FontSize="13" MaxWidth="300" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- §5.4/§5.7  FAIXA DE SISTEMA. Centralizada, nem usuário nem
                             IA. Flutua sobre o fim da lista para não gastar uma linha
                             da grade — as quatro linhas de §2 são fixas. -->
                        <Border x:Name="StatusBar" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,10" Padding="14,9"
                                CornerRadius="14"
                                Background="{StaticResource WarnFill10Brush}"
                                BorderBrush="{StaticResource WarnBorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="StatusText" Text="Pensando…"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBodyBrush}"/>
                        </Border>
                    </Grid>

                    <!-- ── §3.7  BARRA DE INPUT ─────────────────────────── -->
                    <Grid Grid.Row="2" Margin="20,0,20,10">
                        <Border Background="{StaticResource InputFrameBrush}"
                                CornerRadius="{StaticResource RadiusInputFrame}"
                                Padding="1.5">
                            <Border Background="{StaticResource SurfaceInputBarBrush}"
                                    CornerRadius="{StaticResource RadiusInputInner}"
                                    MinHeight="{StaticResource InputHeight}"
                                    Padding="16,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="✦" FontSize="13"
                                               Foreground="{StaticResource AccentLilacBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Popup x:Name="CommandsPopup"
                                           PlacementTarget="{Binding ElementName=InputBox}"
                                           Placement="Top" StaysOpen="False"
                                           AllowsTransparency="True" VerticalOffset="-8">
                                        <Border Background="{StaticResource SurfaceInputBarBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusTooltip}"
                                                Padding="4" Effect="{StaticResource TooltipShadow}">
                                            <ListBox x:Name="CommandsList" Background="Transparent"
                                                     BorderThickness="0" Width="200"
                                                     Foreground="{StaticResource TextBodyBrush}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     PreviewKeyDown="CommandsList_PreviewKeyDown">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,5"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="Transparent"
                                                                            CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background"
                                                                                    Value="{StaticResource AccentFill12Brush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background"
                                                                                    Value="{StaticResource SurfaceHoverSoftBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>

                                    <TextBox x:Name="InputBox" Grid.Column="1"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextNormalBrush}"
                                             CaretBrush="{StaticResource AccentLilacBrush}"
                                             SelectionBrush="{StaticResource AccentLilacBrush}"
                                             FontSize="{StaticResource FontSizeBubble}"
                                             VerticalContentAlignment="Center"
                                             Padding="0,8" MinHeight="32" MaxHeight="110"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             PreviewKeyDown="InputBox_PreviewKeyDown"
                                             TextChanged="InputBox_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Auto"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Placeholder some quando há texto. Nome do agente
                                         entra em ApplyCharacterUI. -->
                                    <TextBlock x:Name="InputPlaceholder" Grid.Column="1"
                                               Text="Fale com o AIB..."
                                               FontSize="{StaticResource FontSizeBubble}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="VisionButton" Style="{StaticResource IconButton}"
                                                Click="VisionButton_Click" ToolTip="Ler tela (OCR)">
                                            <Path Data="M2.5,5.8 H5.4 L6.6,4 H11.4 L12.6,5.8 H15.5 V14 H2.5 Z M9,7.2 A2.6,2.6 0 1 1 9,12.4 A2.6,2.6 0 1 1 9,7.2 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  Width="18" Height="18" Stretch="None"/>
                                        </Button>

                                        <Button x:Name="VoiceButton" Style="{StaticResource IconButton}"
                                                Click="VoiceButton_Click" ToolTip="Falar com o AIB (Whisper)">
                                            <Path Data="M9,2.5 A2,2 0 0 1 11,4.5 V8.5 A2,2 0 0 1 7,8.5 V4.5 A2,2 0 0 1 9,2.5 Z M4.8,8.6 A4.2,4.2 0 0 0 13.2,8.6 M9,12.8 V15.2"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="18" Height="18" Stretch="None"/>
                                        </Button>

                                        <Button x:Name="SendButton" Style="{StaticResource SendButton}"
                                                Click="SendButton_Click" ToolTip="Enviar" Margin="4,0,0,0">
                                            <!-- Aviãozinho. O conteúdo troca para um quadrado
                                                 vermelho enquanto grava (§3.7(e)). -->
                                            <Path x:Name="SendIcon"
                                                  Data="M2,9 L16,2.5 L10.4,15.5 L8.6,10.4 Z"
                                                  Fill="White" Width="18" Height="18" Stretch="None"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- ── §3.8  RODAPÉ DE CONTEXTO ─────────────────────── -->
                    <Grid Grid.Row="3" Margin="26,0,26,14" MinHeight="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ChatTitleText" Text="Nova conversa"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <TextBlock x:Name="TokenCounterText" Grid.Column="1"
                                   Text="0/8192 tokens"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- O painel lateral é uma JANELA à parte (§6), não um filho daqui.
             Como filho, ele dividia a largura com o chat e fazia a janela de
             conversa encolher ao abrir — a armadilha A2. -->
    </Grid>
</Window>
