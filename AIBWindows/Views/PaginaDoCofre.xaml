<UserControl x:Class="AIB.Views.PaginaDoCofre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A página Cofre das Configurações. Grava na hora (como a chave do provedor), fora do
         "Salvar" da tela: um segredo não fica esperando num formulário sujo. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,14,24,20">

            <TextBlock Style="{StaticResource FieldHelpText}" TextWrapping="Wrap"
                       Text="O que você guarda aqui a IA usa no PowerShell pelo nome ($env:COFRE_NOME), sem ver o valor. Ela recebe só o nome, a descrição e os hosts; o valor entra no comando na hora de rodar, e se aparecer na saída volta como [cofre: nome]."/>

            <StackPanel x:Name="Lista" Margin="0,14,0,0"/>

            <TextBlock x:Name="VazioText" Style="{StaticResource FieldHelpText}" Margin="0,4,0,0"
                       Text="Nada guardado ainda." Visibility="Collapsed"/>

            <!-- "Adicionar segredo", como o "Adicionar conta" da página E-mail (pedido do usuário,
                 20/10/2026: o formulário aberto o tempo todo pesava a tela). Some enquanto o
                 formulário está aberto. Os estilos da janela entram por DynamicResource: a
                 página se monta antes de entrar nela. -->
            <Button x:Name="AdicionarButton" Margin="0,4,0,0"
                    Style="{DynamicResource AddAccountButton}" Click="Adicionar_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="None"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M7,2.5 L7,11.5 M2.5,7 L11.5,7" VerticalAlignment="Center"/>
                    <TextBlock Text="Adicionar segredo" FontSize="12" FontWeight="SemiBold"
                               Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>

            <!-- Formulário: segredo novo, ou edição de um que existe. Aparece NO LUGAR do botão;
                 borda lilás = "em edição", como o de conta de e-mail. -->
            <Border x:Name="Formulario" Visibility="Collapsed" Margin="0,4,0,0" Padding="12,12"
                    CornerRadius="10" BorderThickness="1"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    Background="{StaticResource SurfaceCardBrush}">
                <StackPanel>
                    <TextBlock x:Name="FormTitulo" Text="Guardar um segredo" Style="{StaticResource FieldLabelText}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome" Style="{StaticResource FieldHelpText}"/>
                            <TextBox x:Name="NomeBox" Style="{StaticResource ControlTextBoxMono}" Margin="0,4,0,0"
                                     TextChanged="Nome_Mudou"/>
                            <TextBlock x:Name="VariavelText" Style="{StaticResource FieldHelpText}" Margin="0,4,0,0"
                                       Foreground="{StaticResource AccentLilacBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor" Style="{StaticResource FieldHelpText}"/>
                            <PasswordBox x:Name="ValorBox" Style="{StaticResource ControlPasswordBox}" Margin="0,4,0,0"
                                         PasswordChanged="Valor_Mudou"/>
                            <TextBlock x:Name="ValorDica" Text="Some da tela ao guardar e não volta." Style="{StaticResource FieldHelpText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Para que serve (a IA lê isto)" Style="{StaticResource FieldHelpText}" Margin="0,10,0,0"/>
                    <TextBox x:Name="DescricaoBox" Style="{StaticResource ControlTextBox}" Margin="0,4,0,0"/>

                    <TextBlock Text="Hosts permitidos, separados por vírgula" Style="{StaticResource FieldHelpText}" Margin="0,10,0,0"/>
                    <TextBox x:Name="HostsBox" Style="{StaticResource ControlTextBoxMono}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource FieldHelpText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="O comando que usa este segredo só pode falar com estes endereços. Vazio: qualquer um, e o cartão avisa toda vez."/>

                    <!-- Desligado, só uma habilidade usa o segredo: o webhook do Bitrix fica preso
                         às operações da habilidade dele, em vez da API inteira pelo shell. -->
                    <CheckBox x:Name="ShellCheck" IsChecked="True" Margin="0,12,0,0"
                              Foreground="{StaticResource TextBodyBrush}" FontSize="12.5"
                              Content="Permite uso no shell"/>
                    <TextBlock Style="{StaticResource FieldHelpText}" Margin="20,2,0,0" TextWrapping="Wrap"
                               Text="Desmarcado, só as habilidades que declaram este segredo o usam, e cada uma só faz as operações dela."/>

                    <TextBlock x:Name="ErroText" Visibility="Collapsed" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontSize="12" Foreground="{StaticResource DangerTextBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="CancelarButton" Style="{DynamicResource QuietButton}" Margin="0,0,8,0"
                                Content="Cancelar" Click="Cancelar_Click"/>
                        <Button x:Name="GuardarButton" Style="{StaticResource PrimaryButton}"
                                Content="Guardar no cofre" Click="Guardar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
