<Window x:Class="AIB.Views.AvisoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIB — aviso"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        A janela de AVISO: o que o AIB conta sem ter sido chamado — triagem de e-mail, resposta a
        uma conversa sua, rajada de alertas, lembrete. Mockup "Janelas flutuantes do AIB"
        (16/10/2026), família "Aviso".

        Mesma casca das outras flutuantes (moldura neon, vidro). NÃO rouba o foco (ShowActivated
        False, fora da barra de tarefas): quem está digitando continua digitando. Entra pela fila
        (Flutuantes.Mostrar), uma por vez.

        Montada em código (AvisoWindow.Montar): cada tipo de aviso tem pill, título e botões
        próprios, e cinco XAMLs quase iguais divergiriam na primeira correção.
    -->

    <Border Margin="20,14,20,30" Background="{StaticResource NeonBrush}"
            CornerRadius="{StaticResource RadiusWindowOuter}" Padding="1.5"
            Effect="{StaticResource WindowShadow}">
        <Border Background="{StaticResource GlassBrush}"
                CornerRadius="{StaticResource RadiusWindowInner}" ClipToBounds="True">
            <StackPanel Margin="16,15,16,14">

                <!-- TOPO: pill do tipo, selo Shadow, "+N" da fila, hora e o X. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Pill" Grid.Column="0" Style="{StaticResource PillBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PillIcone" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="12" Height="12" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PillTexto" Style="{StaticResource PillText}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SeloShadow" Grid.Column="1" Style="{StaticResource PillBorder}"
                            Margin="6,0,0,0" Visibility="Collapsed"
                            Background="{StaticResource AccentFill08Brush}"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            ToolTip="Veio da conversa do orbe">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentLilacBrush}"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Shadow" Style="{StaticResource PillText}"
                                       Foreground="{StaticResource TextStrongBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SeloFila" Grid.Column="2" Style="{StaticResource PillBorder}"
                            Margin="6,0,0,0" Visibility="Collapsed"
                            ToolTip="Há outros avisos esperando">
                        <TextBlock x:Name="SeloFilaTexto" Style="{StaticResource PillText}"/>
                    </Border>

                    <TextBlock x:Name="HoraTexto" Grid.Column="4"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,6,0"/>

                    <Button x:Name="FecharButton" Grid.Column="5"
                            Style="{StaticResource IconButton}" Width="24" Height="24"
                            ToolTip="Dispensar" Click="Fechar_Click">
                        <Path Data="M5,5 L13,13 M13,5 L5,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="TituloTexto" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextStrongBrush}"
                           TextWrapping="Wrap" Margin="0,11,0,0"/>

                <TextBlock x:Name="SubTexto" FontSize="12.5" LineHeight="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>

                <!-- FALA: a voz da persona (lembrete, resposta pronta). Até 6 linhas: o resto
                     fica na conversa, que é para onde o botão leva. -->
                <TextBlock x:Name="FalaTexto" FontSize="13" LineHeight="19.5"
                           Foreground="{StaticResource TextBodyBrush}"
                           TextWrapping="Wrap" TextTrimming="WordEllipsis"
                           MaxHeight="117" Margin="0,10,0,0"/>

                <!-- DETALHE: texto técnico (o erro), em fonte de código e com rolagem. -->
                <Border x:Name="DetalheBox" Background="{StaticResource SurfaceCodeBrush}"
                        CornerRadius="{StaticResource RadiusCard}" Padding="12,10" Margin="0,11,0,0"
                        Visibility="Collapsed">
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DetalheTexto" FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBodyBrush}"/>
                    </ScrollViewer>
                </Border>

                <!-- AS LINHAS: até três e-mails, clicáveis. -->
                <Border x:Name="CaixaDeLinhas" Background="{StaticResource SurfaceCodeBrush}"
                        CornerRadius="{StaticResource RadiusCard}" Padding="4" Margin="0,11,0,0">
                    <StackPanel x:Name="Linhas"/>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,13,0,0"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="Botoes" Grid.Column="0"/>
                    <TextBlock x:Name="DicaTexto" Grid.Column="1" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- A contagem até fechar sozinho: só nos avisos que fecham. -->
                <Grid x:Name="Contagem" Height="2" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="Restante" Width="1*"/>
                        <ColumnDefinition x:Name="Passado" Width="0*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="1" Background="{StaticResource SurfaceHoverSoftBrush}"/>
                    <Border Grid.Column="0" CornerRadius="1" Opacity="0.5"
                            Background="{StaticResource AccentLilacBrush}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
