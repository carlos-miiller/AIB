<UserControl x:Class="AIB.Views.ContextSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIB.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="300"
             MaxHeight="880" MinHeight="100"
             Background="Transparent">
    
    <UserControl.Resources>
        <Style x:Key="IconTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Aba / Menu Superior -->
        <Border Background="Transparent" CornerRadius="12" Margin="16,16,16,8" Padding="4">
            <UniformGrid Columns="5" Height="34">
                
                <RadioButton x:Name="TabHistory" Style="{StaticResource IconTabStyle}" IsChecked="True" Checked="Tab_Checked" ToolTip="Histórico de Chats">
                    <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zM12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="18" Height="18"/>
                </RadioButton>
                
                <RadioButton x:Name="TabReminders" Style="{StaticResource IconTabStyle}" Checked="Tab_Checked" ToolTip="Lembretes Ativos">
                    <Path Data="M22 5.72l-4.6-3.86-1.29 1.53 4.6 3.86L22 5.72zM7.88 3.39L6.6 1.86 2 5.71l1.29 1.53 4.59-3.85zM12.5 8H11v6l4.75 2.85.75-1.23-4-2.37V8zM12 4c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 16c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="18" Height="18"/>
                </RadioButton>

                <RadioButton x:Name="TabMemories" Style="{StaticResource IconTabStyle}" Checked="Tab_Checked" ToolTip="Memória Recente">
                    <Path Data="M9 21c0 .5.4 1 1 1h4c.6 0 1-.5 1-1v-1H9v1zm3-19C8.1 2 5 5.1 5 9c0 2.4 1.2 4.5 3 5.7V17c0 .5.4 1 1 1h6c.6 0 1-.5 1-1v-2.3c1.8-1.3 3-3.4 3-5.7 0-3.9-3.1-7-7-7z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="18" Height="18"/>
                </RadioButton>

                <RadioButton x:Name="TabContextFiles" Style="{StaticResource IconTabStyle}" Checked="Tab_Checked" ToolTip="Arquivos em Contexto">
                    <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="18" Height="18"/>
                </RadioButton>

                <RadioButton x:Name="TabRecentFiles" Style="{StaticResource IconTabStyle}" Checked="Tab_Checked" ToolTip="Últimos Arquivos Acessados">
                    <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="18" Height="18"/>
                </RadioButton>

            </UniformGrid>
        </Border>

        <!-- Área de Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Margin="16,0,16,8">
                
                <!-- Seção 1: Histórico de Chats (NOVO) -->
                <StackPanel x:Name="PanelHistory" Visibility="Visible">
                    <TextBlock Text="Histórico de Chats" Foreground="#9B51E0" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ChatHistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2AFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm}'}" Foreground="#AAAAAA" FontSize="10"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Tag="{Binding}" Click="RecoverChat_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Recuperar em conversa atual" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="#3182CE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="14" Height="14"/>
                                            </Button>
                                            
                                            <Button Content="✕" Tag="{Binding Id}" Click="DeleteChat_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Excluir chat">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="#888899"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#D53F8C"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoHistoryText" Text="Nenhum chat salvo." Foreground="#666677" FontSize="11" FontStyle="Italic" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ChatHistoryList}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Seção 2: Lembretes -->
                <StackPanel x:Name="PanelReminders" Visibility="Collapsed">
                    <TextBlock Text="Lembretes Ativos" Foreground="#9B51E0" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RemindersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ReminderBorder" Background="#1AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" MouseEnter="Reminder_MouseEnter">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApproaching}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="PulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                From="#1AFFFFFF" To="#4D9B51E0" Duration="0:0:0.8" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTime}" Foreground="#3182CE" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#E0E0E0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="CancelReminder_Click" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoRemindersText" Text="Nenhum lembrete ativo." Foreground="#666677" FontSize="11" FontStyle="Italic" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=RemindersList}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Seção 3: Memória Recente -->
                <StackPanel x:Name="PanelMemories" Visibility="Collapsed">
                    <TextBlock Text="Memória Recente" Foreground="#3182CE" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RecentMemoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Content}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🗑" Tag="{Binding Id}" Click="DeleteMemory_Click" Background="Transparent" Foreground="#D53F8C" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" ToolTip="Esquecer" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="RefreshMemoriesBtn" Content="↻ Atualizar Memórias" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" Click="RefreshMemories_Click" FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Seção 4: Arquivos em Contexto -->
                <StackPanel x:Name="PanelContextFiles" Visibility="Collapsed">
                    <TextBlock Text="Arquivos em Contexto" Foreground="#E28743" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="60" AllowDrop="True" Drop="ContextFiles_Drop">
                        <Grid>
                            <ItemsControl x:Name="ContextFilesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20000000" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#E0E0E0" ToolTip="{Binding FilePath}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenFile_Click"/>
                                                <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveContextFile_Click" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="DragDropHint" Text="Arraste arquivos aqui..." Foreground="#666677" FontSize="11" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=ContextFilesList}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Seção 5: Últimos Arquivos Acessados -->
                <StackPanel x:Name="PanelRecentFiles" Visibility="Collapsed">
                    <TextBlock Text="Últimos Arquivos Acessados" Foreground="#9B51E0" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="40">
                        <Grid>
                            <ItemsControl x:Name="RecentAccessedFilesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20000000" CornerRadius="6" Padding="6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#E0E0E0" ToolTip="{Binding FilePath}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenFile_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
