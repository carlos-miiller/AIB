# O AIB NÃO lê variáveis de ambiente. Provedor, modelo e endereço ficam nas configurações
# (~/.AIB/profile.dat, cifrado), e a chave do OpenRouter fica no cofre DPAPI do Windows —
# nunca em arquivo de texto.
#
# As variáveis abaixo são só dos TESTES (AIB.Tests), todas opcionais.

# Liga o ensaio de integração com um Ollama de verdade (lento; Trait Categoria=Integracao).
AIB_INTEGRACAO=0
AIB_MODELO=qwen3.5:9b
AIB_URL=http://127.0.0.1:11434

# Salva PNGs das janelas nos testes de interface, para conferir o visual.
AIB_UI_PNG=0
AIB_UI_PNG_DIR=
