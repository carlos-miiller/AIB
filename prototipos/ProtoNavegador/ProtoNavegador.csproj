<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Protótipo v1.0 do navegador do AIB. Sem IA: serve para ver, na mesma página, como sai cada
    forma de leitura (árvore inteira, vista só do visível, OCR) e quanto custaria em tokens.
    Fora da solução de propósito — não entra no build do app nem nos testes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProtoNavegador</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Snapshot.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
